{
  "name": "cortico-world-memes",
  "version": "0.6.1",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "type": "module",
  "main": "./index.ts",
  "description": "Cross-channel meme management and vector retrieval with in-context selection",
  "keywords": [
    "cortico-world"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "表情包管理",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "scripts": {
    "test": "node ../../vendor/cortico/node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:web": "node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "build:web": "node scripts/build-webui.mjs"
  }
}
