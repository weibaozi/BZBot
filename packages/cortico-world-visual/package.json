{
  "name": "cortico-world-visual",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "license": "MIT",
  "description": "Visual library: reference pictures of the persona and the people and things it knows, kept in its memory",
  "keywords": [
    "cortico-world"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "图像资料",
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "node ../../vendor/cortico/node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json"
  }
}
