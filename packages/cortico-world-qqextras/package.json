{
  "name": "cortico-world-qqextras",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "type": "module",
  "main": "./index.ts",
  "description": "QQ companion features with semantic meme retrieval",
  "keywords": [
    "cortico-world"
  ],
  "cortico": {
    "kind": "world",
