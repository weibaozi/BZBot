{
  "name": "cortico-world-proactive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "description": "Scheduled private conversation prompts in the existing session",
  "keywords": ["cortico-world"],
  "cortico": { "kind": "world", "api": 6, "displayName": "主动聊天", "webUiClient": "dist/webui.js", "describe": "describe.json" },
  "scripts": {
    "test": "node ../../vendor/cortico/node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:web": "node ../../vendor/cortico/node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json",
    "build:web": "node scripts/build-webui.mjs"
  }
}
