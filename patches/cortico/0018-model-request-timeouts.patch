+import { createServer } from 'node:http';
+import { describe, expect, it } from 'vitest';
+import { withRequestTimeouts, REQUEST_TIMEOUT_DEFAULTS } from '../../src/providers/request-timeouts.ts';
+import { requestTimeoutConfigGroup } from '../../src/providers/request-timeouts-config.ts';
+import { LANGUAGES } from '../../src/core/language.ts';
+import { createResponse, type StreamEvent } from '../../src/protocol/open-responses/index.ts';
+import type { Generation, GenerateOptions } from '../../src/core/generation.ts';
+import { ResponsesProvider } from '../../src/providers/openai-responses-compat/native.ts';
+import { ProviderRegistry } from '../../src/providers/registry.ts';
+import type { ProviderModule } from '../../src/providers/base.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { makeTmpDir } from '../core/helpers.ts';
+
+const request = { model: 'test-model', input: [] };
+const response = createResponse('test-response', request);
+const result: Generation = { response, attempts: [], origin: { instance: 'test', module: 'test', model: 'test-model', compatibilityDomain: 'test' } };
+const delta = { type: 'response.output_text.delta', delta: 'x' } as StreamEvent;
+const wait = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+
+describe('request deadlines', () => {
+  it('ends a stalled call, aborts its transport and drops late events even if a provider ignores cancellation', async () => {
+    let captured!: GenerateOptions; let delivered = 0;
+    await expect(withRequestTimeouts(options => { captured = options; return new Promise(() => {}); },
+      { onEvent: () => delivered++ }, { totalSec: 1, firstContentSec: .04, idleSec: 1 })).rejects.toThrow('first content');
+    expect(captured.signal?.aborted).toBe(true);
+    captured.onEvent?.(delta); expect(delivered).toBe(0);
+  });
+
+  it('times out idle content after the first output', async () => {
+    await expect(withRequestTimeouts(options => { options.onProgress?.(delta); return new Promise(() => {}); }, {},
+      { totalSec: 1, firstContentSec: 1, idleSec: .04 })).rejects.toThrow('content idle');
+  });
+
+  it('total deadline survives continuous content and is not extended by progress', async () => {
+    let timer: ReturnType<typeof setInterval> | undefined;
+    try {
+      await expect(withRequestTimeouts(options => {
+        options.onProgress?.(delta); timer = setInterval(() => options.onProgress?.(delta), 5);
+        return new Promise(() => {});
+      }, {}, { totalSec: .08, firstContentSec: 1, idleSec: .1 })).rejects.toThrow('total timeout');
+    } finally { clearInterval(timer); }
+  });
+
+  it('preserves success and upstream errors and removes timers on completion', async () => {
+    let captured!: GenerateOptions;
+    expect(await withRequestTimeouts(async options => { captured = options; return result; }, {},
+      { totalSec: .02, firstContentSec: .02, idleSec: .02 })).toBe(result);
+    await wait(40); expect(captured.signal?.aborted).toBe(false);
+    const failure = new Error('upstream failure');
+    await expect(withRequestTimeouts(async () => { throw failure; })).rejects.toBe(failure);
+  });
+
+  it('honors caller cancellation without waiting for the deadline', async () => {
+    const controller = new AbortController(); const reason = new Error('operator stopped');
+    const promise = withRequestTimeouts(() => new Promise(() => {}), { signal: controller.signal });
+    controller.abort(reason); await expect(promise).rejects.toBe(reason);
+    let called = false;
+    await expect(withRequestTimeouts(async () => { called = true; return result; }, { signal: controller.signal })).rejects.toBe(reason);
+    expect(called).toBe(false);
+  });
+
+  it('does not apply content-idle timeout before the first content arrives', async () => {
+    const server = createServer((_req, res) => {
+      res.writeHead(200, { 'content-type': 'text/event-stream' });
+      res.write(`data: ${JSON.stringify({ type: 'response.created', sequence_number: 0, response })}\n\n`);
+      const timer = setTimeout(() => res.end(`data: ${JSON.stringify({ type: 'response.completed', sequence_number: 1,
+        response: { ...response, status: 'completed' } })}\n\n`), 100);
+      res.on('close', () => clearTimeout(timer));
+    });
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    try {
+      const client = new ResponsesProvider({ baseUrl: `http://127.0.0.1:${(server.address() as { port: number }).port}` });
+      const generated = await withRequestTimeouts(options => client.respond(request, options), { onEvent: () => {} },
+        { totalSec: 2, firstContentSec: 1, idleSec: .02 });
+      expect(generated.response.status).toBe('completed'); expect(generated.attempts).toHaveLength(1);
+    } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); }
+  });
+
+  it('bounds real HTTP streaming heartbeats and provider retry backoff within one invocation', async () => {
+    let requests = 0; let heartbeat = false;
+    const server = createServer((_req, res) => {
+      requests++;
+      if (!heartbeat) { res.writeHead(503); res.end('busy'); return; }
+      res.writeHead(200, { 'content-type': 'text/event-stream' });
+      res.write(`data: ${JSON.stringify({ type: 'response.created', sequence_number: 0, response })}\n\n`);
+      const timer = setInterval(() => res.write(': heartbeat\n\n'), 5);
+      res.on('close', () => clearInterval(timer));
+    });
+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+    const client = new ResponsesProvider({ baseUrl: `http://127.0.0.1:${(server.address() as { port: number }).port}` });
+    try {
+      await expect(withRequestTimeouts(options => client.respond(request, { ...options, onEvent: () => {} }), {},
+        { totalSec: .5, firstContentSec: 1, idleSec: 1 })).rejects.toThrow('total timeout');
+      expect(requests).toBe(1);
+      heartbeat = true;
+      await expect(withRequestTimeouts(options => client.respond(request, { ...options, onEvent: () => {} }), {},
+        { totalSec: 2, firstContentSec: .5, idleSec: 1 })).rejects.toThrow('first content');
+    } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); }
+  });
+
+  it('uses live settings for each call across provider modules and preserves price/origin options', async () => {
+    const temp = makeTmpDir();
+    let settings = { ...REQUEST_TIMEOUT_DEFAULTS, firstContentSec: .03 };
+    const seen: GenerateOptions[] = [];
+    const modules: ProviderModule[] = ['one', 'two'].map(id => ({ id, title: id, reasoningTiers: [], serviceTiers: [],
+      create: () => ({ client: { respond: async (_request, options = {}) => {
+        seen.push(options); if (settings.firstContentSec < 1) return new Promise<Generation>(() => {}); return result;
+      } } }) }));
+    const registry = new ProviderRegistry(() => ({ a: { kind: 'one', baseUrl: 'http://localhost' }, b: { kind: 'two', baseUrl: 'http://localhost' } }),
+      { stateRoot: temp.dir, readBlob: () => null, keepThinking: () => true, log: nullLogger(), requestTimeouts: () => settings }, modules);
+    try {
+      const bound = registry.bind('a');
+      await expect(bound.respond(request)).rejects.toThrow('first content');
+      await expect(registry.bind('b').respond(request)).rejects.toThrow('first content');
+      settings = { ...REQUEST_TIMEOUT_DEFAULTS };
+      expect(await bound.respond(request)).toBe(result);
+      expect(seen.at(-1)?.origin?.instance).toBe('a'); expect(seen.at(-1)?.quote).toBeTypeOf('function');
+    } finally { temp.cleanup(); }
+  });
+
+  it('publishes bounded hot settings in the persona configuration in all UI languages', () => {
+    for (const language of LANGUAGES) {
+      const group = requestTimeoutConfigGroup(language);
+      expect(group.owner).toBe('persona');
+      expect(Object.keys(group.schema.properties)).toEqual(Object.keys(REQUEST_TIMEOUT_DEFAULTS).map(key => `modelTimeouts.${key}`));
+      for (const field of Object.values(group.schema.properties)) expect(field).toMatchObject({ minimum: 1, maximum: 3600, 'x-hot': true });
+    }
+  });
+});
