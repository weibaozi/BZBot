diff --git a/src/providers/request-timeouts.ts b/src/providers/request-timeouts.ts
new file mode 100644
index 0000000..2eb1961
--- /dev/null
+++ b/src/providers/request-timeouts.ts
@@ -0,0 +1,51 @@
+import type { GenerateOptions, Generation } from '../core/generation.ts';
+import type { StreamEvent } from '../protocol/open-responses/index.ts';
+
+export interface RequestTimeouts { totalSec: number; firstContentSec: number; idleSec: number }
+export const REQUEST_TIMEOUT_DEFAULTS: RequestTimeouts = { totalSec: 120, firstContentSec: 60, idleSec: 60 };
+
+/** A deadline ends the invocation, including provider retries; it never resets on stream traffic. */
+export async function withRequestTimeouts(
+  run: (options: GenerateOptions) => Promise<Generation>, options: GenerateOptions = {},
+  settings: RequestTimeouts = REQUEST_TIMEOUT_DEFAULTS,
+): Promise<Generation> {
+  settings = { ...settings };
+  const controller = new AbortController();
+  const signal = options.signal ? AbortSignal.any([options.signal, controller.signal]) : controller.signal;
+  signal.throwIfAborted();
+  let total: ReturnType<typeof setTimeout>;
+  let activity: ReturnType<typeof setTimeout>;
+  let expired: Error | undefined;
+  let rejectDeadline!: (error: unknown) => void;
+  const deadline = new Promise<never>((_, reject) => { rejectDeadline = reject; });
+  const stop = (kind: string, seconds: number) => {
+    expired = new Error(`Model request ${kind} timeout (${seconds}s)`);
+    expired.name = 'ModelRequestTimeoutError';
+    controller.abort(expired);
+  };
+  const onAbort = () => rejectDeadline(signal.reason);
+  signal.addEventListener('abort', onAbort, { once: true });
+  total = setTimeout(() => stop('total', settings.totalSec), settings.totalSec * 1000);
+  activity = setTimeout(() => stop('first content', settings.firstContentSec), settings.firstContentSec * 1000);
+  const progress = (event: StreamEvent) => {
+    if (signal.aborted) return;
+    const content = ('delta' in event && typeof event.delta === 'string' && event.delta.length > 0)
+      || event.type === 'response.output_item.added' || event.type === 'response.output_item.done';
+    if (content) {
+      clearTimeout(activity);
+      activity = setTimeout(() => stop('content idle', settings.idleSec), settings.idleSec * 1000);
+    }
+  };
+  try {
+    return await Promise.race([run({ ...options, signal, requestTimeouts: settings,
+      onProgress: event => { if (!signal.aborted) { progress(event); options.onProgress?.(event); } },
+      onEvent: options.onEvent ? event => { if (!signal.aborted) { progress(event); options.onEvent!(event); } } : undefined,
+    }), deadline]);
+  } catch (error) {
+    // A local deadline must not become a retryable upstream error in the agent loop.
+    throw expired ?? error;
+  } finally {
+    clearTimeout(total!); clearTimeout(activity!);
+    signal.removeEventListener('abort', onAbort);
+  }
+}
