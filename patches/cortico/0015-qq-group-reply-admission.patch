diff --git a/src/worlds/qq/group-admission.ts b/src/worlds/qq/group-admission.ts
new file mode 100644
index 0000000..a6aa565
--- /dev/null
+++ b/src/worlds/qq/group-admission.ts
@@ -0,0 +1,80 @@
+import type { CandidateProjector, EventEnvelope, WorldHost } from '../../core/types.ts';
+
+export interface GroupReplyConfig { probability: number; recentMessages: number; forceMention: boolean }
+export const GROUP_REPLY_DEFAULTS: GroupReplyConfig = { probability: 10, recentMessages: 20, forceMention: true };
+
+/** Group originals stay in the event store; only selected, bounded batches enter the session. */
+export function groupAdmissionHost(host: WorldHost, config: () => GroupReplyConfig): WorldHost {
+  const waitingVoice = new Set<string>();
+  const groupId = (event: Pick<EventEnvelope, 'meta'>): number | undefined => {
+    const conv = event.meta?.conv as { kind?: string; id?: number } | undefined;
+    return conv?.kind === 'group' ? Number(conv.id) : undefined;
+  };
+  const recent = (id: number, limit: number): EventEnvelope[] => {
+    const picked: EventEnvelope[] = [];
+    let cursor = host.store.latestCursor();
+    while (cursor > 0 && picked.length < limit) {
+      const page = host.store.range({ source: 'qq', toCursor: cursor, limit: 200 });
+      if (!page.length) break;
+      for (let i = page.length - 1; i >= 0 && picked.length < limit; i--) {
+        const event = page[i];
+        if (groupId(event) === id && (event.type === 'qq.message' || event.type === 'qq.self')) picked.push(event);
+      }
+      cursor = page[0].cursor - 1;
+    }
+    return picked.reverse();
+  };
+  const project: CandidateProjector = candidates => {
+    const groups = new Map<number, number[]>();
+    candidates.forEach((candidate, index) => {
+      const id = (candidate.value as { id: number }).id;
+      const indexes = groups.get(id) ?? []; indexes.push(index); groups.set(id, indexes);
+    });
+    return [...groups].map(([id, candidateIndexes]) => {
+      const rows = recent(id, config().recentMessages);
+      const ids = new Set(rows.map(row => String(row.meta?.message_id)));
+      const first = rows[0]?.cursor ?? host.store.latestCursor();
+      const extras = host.store.range({ source: 'qq', fromCursor: first }).filter(event =>
+        groupId(event) === id && ids.has(String(event.meta?.message_id)) &&
+        ['qq.image', 'qq.vision', 'qq.transcript', 'qq.forward', 'qq.reply.uncaptured'].includes(event.type));
+      const context = [...rows, ...extras].sort((a, b) => a.cursor - b.cursor);
+      const forced = candidateIndexes.some(index => (candidates[index].value as { forced: boolean }).forced);
+      return { candidateIndexes, event: {
+        type: 'qq.group_context',
+        text: `[群 ${id}：最近 ${rows.length} 条消息；${forced ? '被 @ 触发，请回应提及你的消息' : '概率触发，可结合话题决定回复'}。以下为群聊原始内容]\n` + context.map(row => row.text).join('\n'),
+        meta: { conv: { kind: 'group', id }, forcedMention: forced, contextMessageCursors: rows.map(row => row.cursor) },
+        blobs: context.flatMap(row => row.blobs ?? []),
+      } };
+    });
+  };
+  const trigger = async (event: EventEnvelope, id: number, forced: boolean) => {
+    if (!host.pushCandidate) throw new Error('QQ group replies require the candidate delivery interface');
+    await host.pushCandidate({
+      sourceEvents: [{ type: 'qq.group_trigger', ts: event.ts, text: `Group reply selected for #${event.meta?.message_id}`,
+        meta: { conv: { kind: 'group', id }, message_id: event.meta?.message_id } }],
+      gateText: event.text, value: { id, forced }, project,
+    }, { trigger: forced ? 'flush' : 'debounce' });
+  };
+  const wrapped = Object.create(host) as WorldHost;
+  wrapped.pushEvent = async (event, options) => {
+    const id = groupId(event);
+    if (id === undefined || options?.deliver === false) return host.pushEvent(event, options);
+    const saved = await host.pushEvent(event, { ...options, deliver: false });
+    const key = `${id}:${event.meta?.message_id}`;
+    if (event.type === 'qq.message') {
+      const settings = config();
+      const forced = settings.forceMention && event.meta?.mentionedSelf === true;
+      const selected = forced || (settings.probability > 0 && Math.random() * 100 < settings.probability);
+      if (selected) {
+        if (options?.trigger === 'piggyback' && !forced) {
+          waitingVoice.add(key);
+          if (waitingVoice.size > 1000) waitingVoice.delete(waitingVoice.values().next().value!);
+        } else await trigger(saved, id, forced);
+      }
+    } else if (event.type === 'qq.transcript' && waitingVoice.delete(key)) {
+      await trigger(saved, id, false);
+    }
+    return saved;
+  };
+  return wrapped;
+}
