+import { expect, it } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { MockOneBot } from '../helpers/mock-onebot.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir, sleep } from '../core/helpers.ts';
+
+async function fixture() {
+ const tmp=makeTmpDir(),mock=new MockOneBot({port:0,groupId:424242,selfId:5000});
+ const port=await mock.start(),cfg=makeCfg(),llm=new FakeLLM();
+ cfg.worlds.qq={...cfg.worlds.qq,enabled:true,wsUrl:`ws://127.0.0.1:${port}`,groupReply:{probability:0,recentMessages:3,forceMention:true},
+ groups:[{id:424242,enabled:true},{id:424243,enabled:true}],privates:[{id:1001,enabled:true}]};
+ cfg.worlds.console.enabled=false;cfg.web.port=0;cfg.tick.dayIntervalMinutes=[999,999];cfg.tick.nightIntervalMinutes=null;
+ const memoryDir=join(tmp.dir,'memory');mkdirSync(memoryDir,{recursive:true});writeFileSync(join(memoryDir,'CONSTITUTION.md'),'Fixture persona');
+ const loaded=makeLoaded({config:cfg,rootDir:tmp.dir,memoryDir,dataDir:join(tmp.dir,'data')});
+ let bot=assembleBot(loaded,{llm});
+ bot.core.bus.setPaused(true);await bot.start();await bot.qqWorld!.waitReady(5000);
+ const group=async(text:string,mention=false,id=424242)=>{
+ const mid=mock.emitGroupMessage({user_id:1001,text,group_id:id,...(mention?{segments:[{type:'at',data:{qq:'5000'}},{type:'text',data:{text}}]}:{})});
+ await expect.poll(()=>bot.core.store.range({source:'qq'}).some(e=>e.type==='qq.message'&&e.meta?.message_id===mid)).toBe(true);
+ await sleep(20);return mid;
+ };
+ const done=async()=>{await bot.stop();await mock.close();tmp.cleanup();};
+ return {bot,cfg,llm,mock,group,done,async restart(){await bot.stop();bot=assembleBot(loaded,{llm});await bot.start();await bot.qqWorld!.waitReady(5000);bot.core.bus.setPaused(false);return bot;}};
+}
+
+it('archives zero-probability messages, keeps private delivery, and leaves history accessible',async()=>{
+ const {bot,cfg,llm,mock,group,done}=await fixture();
+ try{
+ cfg.worlds.qq.groupReply.forceMention=false;
+ await group('ARCHIVED_ONLY_A');await group('ARCHIVED_ONLY_B',true);
+ bot.core.bus.setPaused(false);
+ mock.emitPrivateMessage({user_id:1001,text:'PRIVATE_DELIVERED'});
+ await expect.poll(()=>JSON.stringify(llm.calls),{timeout:6000}).toContain('PRIVATE_DELIVERED');
+ expect(JSON.stringify(llm.calls)).not.toContain('ARCHIVED_ONLY_');
+ const rows=bot.core.store.range({source:'qq'}).filter(e=>e.meta?.conv&&(e.meta.conv as any).kind==='group'&&e.type==='qq.message');
+ expect(rows).toHaveLength(2);expect(rows.every(e=>e.contextDelivery==='archive-only')).toBe(true);
+ const result=await bot.qqWorld!.tools().find(t=>t.name==='qq_read_history')!.handler({conversation:'group:424242',limit:10},{role:'main',log:nullLogger()});
+ expect(JSON.stringify(result)).toContain('ARCHIVED_ONLY_A');
+ }finally{await done();}
+},15000);
+
+it('forced mention bypasses zero probability and delivers only the latest messages of that group',async()=>{
+ const {bot,llm,group,done}=await fixture();
+ try{
+ await group('OLD_EXCLUDED');await group('RECENT_A');await group('OTHER_GROUP',false,424243);await group('RECENT_B');await group('MENTION_TRIGGER',true);
