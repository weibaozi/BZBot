+it.each(['private', 'group'] as const)('qq_send sends text then image in one call for %s', async (kind) => {
+  const { cfg, mock, tool, ctx, incoming, self, done, memoryDir } = await fixture();
+  try {
+    cfg.worlds.qq.quoteReply = true;
+    const mid = await incoming(kind);
+    const images = join(memoryDir, 'external', 'qq', 'images'); mkdirSync(images, { recursive: true });
+    writeFileSync(join(images, 'cat.png'), Buffer.from('89504e470d0a1a0a0000000d49484452', 'hex'));
+    const receipt = await tool('qq_send').handler({ reply_to: String(mid), text: '看。猫', image: 'mem:external/qq/images/cat.png' }, ctx);
