diff --git a/tests/web/provider-generation.test.ts b/tests/web/provider-generation.test.ts
new file mode 100644
index 0000000..6ed9d1d
--- /dev/null
+++ b/tests/web/provider-generation.test.ts
@@ -0,0 +1,155 @@
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { createServer } from 'node:http';
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { createWebUi } from '../../src/web/client/ui/index.ts';
+import { Lifecycle } from '../../src/web/client/core/lifecycle.ts';
+import { mountDetail } from '../../src/web/client/features/providers/detail.ts';
+import { GENERATION_DEFAULTS, newModelSpec, reasoningControl } from '../../src/web/client/features/providers/generation.ts';
+import type { FeatureContext } from '../../src/web/client/features/feature.ts';
+import type { Detail, Editing } from '../../src/web/client/features/providers/types.ts';
+import { ProviderHub } from '../../src/providers/webui/hub.ts';
+import { ProviderRegistry } from '../../src/providers/registry.ts';
+import { ProviderSettings } from '../../src/providers/webui/settings.ts';
+import { matchingEfforts } from '../../src/providers/effort-presets.ts';
+import { responseRequest } from '../../src/protocol/open-responses/context-helpers.ts';
+import { buildResponsesBody } from '../../src/providers/openai-responses-compat/native.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { makeCfg, makeTmpDir } from '../core/helpers.ts';
+
+const cleanups: Array<() => void | Promise<void>> = [];
+const NodeAbortController = globalThis.AbortController;
+// Node resolves the real provider registry; the controls use a real DOM in the same test.
+const DOM_MODULE = 'jsdom';
+const { JSDOM } = await import(DOM_MODULE);
+beforeEach(() => {
+  const dom = new JSDOM('<!doctype html><html lang="zh"><body></body></html>', { url: 'http://localhost', pretendToBeVisual: true });
+  for (const key of ['window', 'document', 'location', 'localStorage', 'Event', 'HTMLElement', 'HTMLInputElement', 'HTMLSelectElement', 'AbortController', 'requestAnimationFrame', 'cancelAnimationFrame'])
+    vi.stubGlobal(key, key === 'window' ? dom.window : dom.window[key]);
+  cleanups.push(() => dom.window.close());
+});
+afterEach(async () => { for (const cleanup of cleanups.reverse()) await cleanup(); cleanups.length = 0; vi.unstubAllGlobals(); });
+const preset = { host: 'model.test', models: ['thinking-model'], efforts: ['none', 'low', 'high', 'max'] };
+const fixedModule = { reasoningTiers: [], effortSuggestions: ['none', 'low', 'medium', 'high'], effortPresets: [preset] };
+const endpoint = (): Detail['entry'] => ({ kind: 'openai-responses-compat', baseUrl: 'https://model.test/v1', spec: { model: 'thinking-model', thinking: true, reasoningEffort: 'low' } });
+function widgets() {
+  const lifecycle = new Lifecycle(error => { throw error; }); cleanups.push(() => lifecycle.dispose());
+  const ui = createWebUi({ memo: { get: (_key, fallback) => fallback, set: () => {} }, overlayHost: document.body, signal: lifecycle.signal, doc: document });
+  return { ui, lifecycle };
+}
+function control(entry = endpoint(), module = fixedModule) {
+  const { ui } = widgets();
+  const widget = reasoningControl(ui, module, entry, () => {}); document.body.append(widget.el);
+  const select = widget.el.querySelector('select')!;
+  return { entry, widget, select, choose: (value: string) => { select.value = value; select.dispatchEvent(new Event('change')); } };
+}
+const wire = (entry: Detail['entry']) => buildResponsesBody(responseRequest(entry.spec!, []), {}, { reasoningReplay: 'plaintext' });
+
+it('selects native effort names and sends none explicitly, while model default omits effort and temperature', () => {
+  const { entry, choose, select } = control();
+  expect([...select.options].map(option => option.value)).toEqual(['', ...preset.efforts]);
+  choose('max'); expect(wire(entry).reasoning).toEqual({ effort: 'max' });
+  choose('none'); expect(wire(entry).reasoning).toEqual({ effort: 'none' });
+  expect(entry.spec).not.toHaveProperty('reasoningEffort');
+  choose(''); expect(wire(entry)).not.toHaveProperty('reasoning');
+  expect(wire(entry)).not.toHaveProperty('temperature');
+});
+it('matches exact hosts and model aliases or dated snapshots without guessing capabilities for gateways or variants', () => {
+  expect(matchingEfforts([preset], 'https://model.test/v1/', 'thinking-model-2026-10-01')).toEqual(preset.efforts);
+  for (const [url, model] of [['https://model.test.attacker.test', 'thinking-model'], ['https://gateway.test', 'thinking-model'], ['https://model.test', 'thinking-model-pro'], ['bad url', 'thinking-model']])
+    expect(matchingEfforts([preset], url, model)).toBeUndefined();
+});
+it('preserves an existing effort while a model changes and requires a supported selection before saving', () => {
+  const entry = endpoint(); entry.spec!.reasoningEffort = 'medium';
+  const { widget, choose, select } = control(entry);
+  expect(select.value).toBe('medium'); expect(widget.valid()).toBe(false);
+  expect(entry.spec!.reasoningEffort).toBe('medium');
+  choose('high'); expect(widget.valid()).toBe(true);
+  entry.baseUrl = 'https://gateway.test'; widget.refresh();
+  expect([...select.options].map(option => option.value)).toContain('medium');
+});
+it('keeps custom efforts usable on unknown gateways and retains fixed module tiers', () => {
+  const entry = endpoint(); entry.baseUrl = 'https://gateway.test'; entry.spec!.reasoningEffort = 'adaptive';
+  const { widget, select, choose } = control(entry);
+  expect(select.value).toBe('adaptive'); expect(widget.valid()).toBe(true);
+  choose('custom');
+  const input = widget.el.querySelector('input')!; input.value = 'extended'; input.dispatchEvent(new Event('input'));
+  expect(wire(entry).reasoning).toEqual({ effort: 'extended' });
+  const { ui } = widgets();
+  const fixed = reasoningControl(ui, { ...fixedModule, reasoningTiers: [{ id: 'off', label: 'Off', thinking: false }, { id: 'on', label: 'On', thinking: true }] },
+    { ...endpoint(), spec: { model: 'test-model', thinking: false } }, () => {});
+  expect([...fixed.el.querySelector('select')!.options].map(option => option.value)).toEqual(['off', 'on']);
+});
+
+/** A real HTTP listener and ProviderHub persist the form; no running deployment or external service is used. */
+async function editor(existing?: Detail['entry']) {
+  const temp = makeTmpDir(); cleanups.push(temp.cleanup);
+  const rootDir = join(temp.dir, 'providers'); mkdirSync(rootDir);
+  const file = join(temp.dir, 'config.json'); writeFileSync(file, '{}');
+  const cfg = makeCfg({ providers: {}, activeProvider: '' });
+  const registry = new ProviderRegistry(() => cfg.providers, { stateRoot: rootDir, readBlob: () => null, keepThinking: () => true, log: nullLogger() });
+  const hub = new ProviderHub(cfg, registry, new ProviderSettings(cfg, registry, file, rootDir), file, rootDir);
+  const saved = existing ? hub.save(null, { name: 'Sample', entry: existing }, 'zh') : null;
+  const server = createServer(async (req, res) => {
+    try {
+      let raw = ''; for await (const chunk of req) raw += chunk;
+      const body = JSON.parse(raw || '{}');
+      const result = req.url === '/api/provider-modules/config' ? hub.groups(body.name, body.entry, 'zh')
+        : req.url === '/api/providers' ? hub.save(null, body, 'zh')
+        : req.url === '/api/providers/Sample/save' ? hub.save('Sample', body, 'zh') : null;
+      res.setHeader('Content-Type', 'application/json'); res.end(JSON.stringify(result));
+    } catch (error) { res.statusCode = 400; res.end(JSON.stringify({ error: String(error) })); }
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  cleanups.push(() => new Promise<void>(resolve => { server.close(() => resolve()); server.closeAllConnections(); }));
+  const address = server.address() as { port: number };
+  const fetchHttp = globalThis.fetch;
+  vi.stubGlobal('fetch', async (url: string, init?: RequestInit) => {
+    const controller = new NodeAbortController();
+    const abort = () => controller.abort();
+    if (init?.signal?.aborted) abort(); else init?.signal?.addEventListener('abort', abort, { once: true });
+    try { return await fetchHttp(new URL(url, `http://127.0.0.1:${address.port}`), { ...init, signal: controller.signal }); }
+    finally { init?.signal?.removeEventListener('abort', abort); }
+  });
+  const { ui, lifecycle } = widgets();
+  const root = document.createElement('div'); document.body.append(root);
+  const ctx = { root, ui, signal: lifecycle.signal, lifecycle, onError: (error: unknown) => { throw error; } } as unknown as FeatureContext;
+  let changed: Editing | null = null; let savedName = '';
+  const modules = hub.moduleList('zh');
+  await mountDetail({ ctx, root, modules, saved,
+    draft: saved ? null : { original: null, name: 'Sample', entry: { kind: '', baseUrl: '' }, secretValue: '', raw: {} },
+    changed: value => { changed = value; }, onSaved: async name => { savedName = name; }, cancelled: async () => {}, deleted: async () => {}, duplicate: async () => {},
+  }).then(controller => cleanups.push(() => controller.dispose()));
+  return { root, hub, rootDir, changed: () => changed!, savedName: () => savedName };
+}
+it('new endpoint defaults survive a real save and omit temperature on the wire', async () => {
+  const draft = await editor();
+  const kind = draft.root.querySelector<HTMLSelectElement>('[aria-label="供应商类型"]')!;
+  kind.value = 'openai-responses-compat'; kind.dispatchEvent(new Event('change'));
+  await vi.waitFor(() => expect(draft.root.querySelector('[aria-label="模型"]')).not.toBeNull());
+  expect(draft.changed().entry.spec).toEqual(newModelSpec());
+  const model = draft.root.querySelector<HTMLInputElement>('[aria-label="模型"]')!;
+  model.value = 'test-model'; model.dispatchEvent(new Event('input'));
+  const url = draft.root.querySelector<HTMLInputElement>('[aria-label="API 地址"]')!;
+  url.value = 'https://model.test'; url.dispatchEvent(new Event('input'));
+  [...draft.root.querySelectorAll('button')].find(button => button.textContent === '保存')!.click();
+  await vi.waitFor(() => expect(draft.savedName()).toBe('Sample'));
+  const persisted = JSON.parse(readFileSync(join(draft.rootDir, 'Sample', 'config.json'), 'utf8'));
+  expect(persisted.spec).toMatchObject(GENERATION_DEFAULTS);
+  expect(wire(persisted)).toMatchObject({ max_output_tokens: GENERATION_DEFAULTS.maxTokens });
+  expect(wire(persisted)).not.toHaveProperty('temperature');
+});
+it('opening an endpoint preserves saved values and resetting temperature omits it from the persisted request', async () => {
+  const entry = endpoint(); entry.spec = { ...entry.spec!, temperature: 0.65, maxTokens: 4000, contextWindow: 32000 };
+  const { root, changed, savedName, hub } = await editor(entry);
+  expect(changed().entry).toEqual(hub.detail('Sample', 'zh').entry);
+  const temperature = root.querySelector<HTMLInputElement>('[aria-label="温度"]')!;
+  expect(temperature.value).toBe('0.65');
+  [...root.querySelectorAll('button')].find(button => button.textContent === '使用模型默认值')!.click();
+  expect(temperature.value).toBe('');
+  [...root.querySelectorAll('button')].find(button => button.textContent === '保存')!.click();
+  await vi.waitFor(() => expect(savedName()).toBe('Sample'));
+  const saved = hub.detail('Sample', 'zh').entry;
+  expect(saved.spec).toMatchObject({ maxTokens: 4000, contextWindow: 32000 });
+  expect(wire(saved)).not.toHaveProperty('temperature');
+});
