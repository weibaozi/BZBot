diff --git a/tests/world-mounted.test.ts b/tests/world-mounted.test.ts
new file mode 100644
index 0000000..68305e2
--- /dev/null
+++ b/tests/world-mounted.test.ts
@@ -0,0 +1,34 @@
+/** A World can see which Worlds are mounted right now, its own included. */
+import { afterEach, expect, it } from 'vitest';
+import { loadDeployment } from '../src/deploy.ts';
+import { NO_MODELS } from '../src/providers/model-hub.ts';
+import { WorldAssembly, type WorldContext, type WorldDefinition } from '../src/world.ts';
+import { makeCfg, makeTmpDir } from './core/helpers.ts';
+
+const cleanups: Array<() => void> = [];
+afterEach(() => cleanups.splice(0).forEach(fn => fn()));
+
+it('lists the mounted Worlds at each call, following activation', async () => {
+  const temp = makeTmpDir(); cleanups.push(temp.cleanup);
+  const contexts = new Map<string, WorldContext>();
+  const def = (id: string, enabled: boolean): WorldDefinition => ({
+    id, label: id, defaults: () => ({ enabled }),
+    create: (ctx) => { contexts.set(id, ctx); return { id, tools: () => [], envPromptVars: () => null, start: async () => {}, stop: async () => {} }; },
+  });
+  const loaded = loadDeployment({ defaults: () => makeCfg() }, temp.dir, temp.dir);
+  const assembly = new WorldAssembly(loaded, [def('skills', true), def('browser', false)], [], NO_MODELS);
+  // Stands in for core, which keeps the shared mounted list as it mounts and unmounts.
+  assembly.bind({
+    mount: async (mod) => { assembly.mounted.push(mod); },
+    unmount: async (id) => { assembly.mounted.splice(assembly.mounted.findIndex((mod) => mod.id === id), 1); },
+  });
+  const skills = contexts.get('skills')!;
+  expect(skills.mountedWorlds?.()).toEqual(['skills']);
+  const browser = contexts.get('browser')!;
+  browser.cfg.enabled = true;
+  await browser.restart();
+  expect(skills.mountedWorlds?.()).toEqual(['skills', 'browser']);
+  browser.cfg.enabled = false;
+  await browser.restart();
+  expect(skills.mountedWorlds?.()).toEqual(['skills']);
+});
