+import { splitText, type SegmentRule } from './segment.ts';
+
+export type MentionTokens = Record<string, string>;
+
+/** Internal single-character tokens keep mentions indivisible during text splitting. */
+export function parseMessageChain(messages: unknown, text: unknown): { text: string; mentions?: MentionTokens } {
+  if (messages === undefined || messages === null) return { text: typeof text === 'string' ? text : '' };
+  if (typeof text === 'string' && text.trim()) throw new Error('Use either messages or text, not both');
+  if (!Array.isArray(messages) || !messages.length || messages.length > 256) throw new Error('messages must contain 1–256 components');
+  const plain = messages.map(item => typeof item?.text === 'string' ? item.text : '').join('');
+  const mentions: MentionTokens = {};
+  let encoded = '', next = 0xe000;
+  for (const item of messages) {
+    if (!item || typeof item !== 'object') throw new Error('Each message component must be an object');
+    if (item.type === 'plain' && typeof item.text === 'string') encoded += item.text;
+    else if (item.type === 'mention_user' && typeof item.mention_user_id === 'string' && /^[1-9]\d{4,15}$/.test(item.mention_user_id)) {
+      while (next <= 0xf8ff && plain.includes(String.fromCharCode(next))) next++;
+      if (next > 0xf8ff) throw new Error('No available mention token');
+      const token = String.fromCharCode(next++);
+      mentions[token] = item.mention_user_id;
+      encoded += token;
+    } else throw new Error('Use plain with text, or mention_user with a numeric QQ mention_user_id');
+  }
+  if (!encoded.trim()) throw new Error('messages must not be empty');
+  return { text: encoded, mentions };
+}
+
+export function chainSegments(text: string, mentions: MentionTokens = {}): Array<{ type: string; data: Record<string, string> }> {
+  const result: Array<{ type: string; data: Record<string, string> }> = [];
+  let plain = '';
+  const flush = () => { if (plain) result.push({ type: 'text', data: { text: plain } }); plain = ''; };
+  for (const char of text) {
+    if (Object.hasOwn(mentions, char)) { flush(); result.push({ type: 'at', data: { qq: mentions[char] } }); }
+    else plain += char;
+  }
+  flush();
+  return result;
+}
+
+export function chainText(text: string, mentions?: MentionTokens): string {
+  return chainSegments(text, mentions).map(part => part.type === 'at' ? `@${part.data.qq}` : part.data.text).join('');
+}
+
+export function splitChain(text: string, rule: SegmentRule, mentions?: MentionTokens): string[] {
+  const parts = splitText(text, rule);
+  if (!mentions || !Object.keys(mentions).length) return parts;
+  const tokens = (value: string) => [...value].filter(char => Object.hasOwn(mentions, char)).join('');
+  // Custom extraction/cleanup patterns may erase or duplicate tokens. Send whole instead.
+  return tokens(parts.join('')) === tokens(text) ? parts : [text];
+}
