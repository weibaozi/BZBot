+import { expect, it } from 'vitest';
+import { parseMessageChain, splitChain, chainSegments, chainText } from '../../../src/worlds/qq/message-chain.ts';
+import { SEGMENT_DEFAULTS } from '../../../src/worlds/qq/segment.ts';
+it('keeps mention identity across word splitting and protects it from cleanup/extraction',()=>{
+ const chain=parseMessageChain([{type:'plain',text:'Hi\ue000'},{type:'mention_user',mention_user_id:'10001'},
+ {type:'plain',text:'。Bye'},{type:'mention_user',mention_user_id:'10001'},{type:'plain',text:'！'}],undefined);
+ const rule={...SEGMENT_DEFAULTS().private,mode:'words' as const,words:'。 ！'};
+ const parts=splitChain(chain.text,rule,chain.mentions);
+ expect(parts.map(part=>chainText(part,chain.mentions))).toEqual(['Hi\ue000@10001','Bye@10001']);
+ expect(parts.flatMap(part=>chainSegments(part,chain.mentions)).filter(part=>part.type==='at')).toHaveLength(2);
+ expect(splitChain(chain.text,{...rule,cleanup:'[\ue000-\uf8ff]'},chain.mentions)).toEqual([chain.text]);
+ expect(splitChain(chain.text,{...rule,mode:'regex',regex:'[A-Za-z]+'},chain.mentions)).toEqual([chain.text]);
+ expect(splitChain(chain.text,{...rule,enabled:false},chain.mentions)).toEqual([chain.text]);
+});
