diff --git a/src/worlds/delivery-hints.ts b/src/worlds/delivery-hints.ts
new file mode 100644
index 0000000..1220e14
--- /dev/null
+++ b/src/worlds/delivery-hints.ts
@@ -0,0 +1,31 @@
+/** Trusted extension reminders appended through the Persona delivery hook, never the prefix. */
+import { resolve } from 'node:path';
+import type { CoreApi, EventEnvelope, Persona } from '../core/types.ts';
+type Hint = (events: readonly EventEnvelope[]) => string | null;
+const hints = new Map<string, Map<string, Hint>>();
+function key(dir: string) { const path = resolve(dir); return process.platform === 'win32' ? path.toLowerCase() : path; }
+export function registerDeliveryHint(dir: string, owner: string, hint: Hint): () => void {
+  const scope = key(dir);
+  let entries = hints.get(scope);
+  if (!entries) hints.set(scope, entries = new Map());
+  if (entries.has(owner)) throw new Error(`Delivery hint already registered: ${owner}`);
+  entries.set(owner, hint);
+  return () => {
+    if (entries.get(owner) === hint) entries.delete(owner);
+    if (!entries.size && hints.get(scope) === entries) hints.delete(scope);
+  };
+}
+/** Install at bot assembly; normal Persona hooks and attachment keep their original receiver. */
+export function withDeliveryHints(persona: Persona, dir: string): void {
+  let api: CoreApi | undefined;
+  const attach = persona.attach.bind(persona);
+  const onDelivery = persona.onDelivery?.bind(persona);
+  persona.attach = core => { attach(core); api = core; };
+  persona.onDelivery = async context => {
+    await onDelivery?.(context);
+    for (const [owner, hint] of hints.get(key(dir)) ?? []) {
+      const text = hint(context.events);
+      if (text) api?.injectInternal(text, `${owner}.hint`);
+    }
+  };
+}
