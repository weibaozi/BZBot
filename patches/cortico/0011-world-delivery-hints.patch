+import { expect, it } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { registerDeliveryHint } from '../../src/worlds/delivery-hints.ts';
+import { MockOneBot } from '../helpers/mock-onebot.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir, sleep } from '../core/helpers.ts';
+it('isolates reminders, preserves the prefix and unregisters delivery callbacks', async () => {
+  const tmp = makeTmpDir(), mock = new MockOneBot({ port: 0, groupId: 424242 });
+  const port = await mock.start(), cfg = makeCfg(), llm = new FakeLLM();
+  cfg.worlds.qq = { ...cfg.worlds.qq, enabled: true, wsUrl: `ws://127.0.0.1:${port}`, groups: [{ id: 424242, enabled: true }], privates: [] };
+  cfg.worlds.console.enabled = false; cfg.web.port = 0;
+  cfg.tick.dayIntervalMinutes = [999, 999]; cfg.tick.nightIntervalMinutes = null;
+  cfg.batching.quietGapMs = 20; cfg.batching.maxBatchAgeMs = 100;
+  const memoryDir = join(tmp.dir, 'memory'); mkdirSync(memoryDir, { recursive: true });
+  writeFileSync(join(memoryDir, 'CONSTITUTION.md'), 'Fixture persona');
+  const bot = assembleBot(makeLoaded({ config: cfg, rootDir: tmp.dir, memoryDir, dataDir: join(tmp.dir, 'data') }), { llm });
+  const release = registerDeliveryHint(tmp.dir, 'fixture', events => events.some(e => e.type === 'qq.message') ? 'fixture reminder' : null);
+  const other = registerDeliveryHint(join(tmp.dir, 'other'), 'fixture', () => 'wrong deployment');
+  try {
+    expect(() => registerDeliveryHint(tmp.dir, 'fixture', () => null)).toThrow('already registered');
+    await bot.start(); await bot.qqWorld!.waitReady(5000);
+    const deliver = async (text: string) => {
+      mock.emitGroupMessage({ user_id: 1001, nickname: 'fixture', text });
+      await expect.poll(() => llm.calls.some(c => JSON.stringify(c.messages).includes(text)), { timeout: 5000 }).toBe(true);
+      await sleep(80);
+    };
+    await deliver('first chat');
+    const prefix = JSON.stringify(llm.calls.at(-1)!.messages[0]);
+    expect(prefix).not.toContain('fixture reminder');
+    expect(JSON.stringify(llm.calls.at(-1)!.messages)).toContain('fixture reminder');
+    expect(JSON.stringify(llm.calls)).not.toContain('wrong deployment');
+    const count = () => bot.core.store.range({}).filter(e => e.type === 'fixture.hint').length;
+    expect(count()).toBe(1); release();
+    await deliver('second chat');
+    expect(count()).toBe(1);
+    expect(JSON.stringify(llm.calls.at(-1)!.messages[0])).toBe(prefix);
+  } finally { release(); other(); await bot.stop(); await mock.close(); tmp.cleanup(); }
+}, 15000);
