diff --git a/tests/providers/image-generation.test.ts b/tests/providers/image-generation.test.ts
new file mode 100644
index 0000000..0f470bd
--- /dev/null
+++ b/tests/providers/image-generation.test.ts
@@ -0,0 +1,59 @@
+import { expect, it } from 'vitest';
+import { createServer } from 'node:http';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { makeTmpDir, makeCfg } from '../core/helpers.ts';
+import { ProviderHub } from '../../src/providers/webui/hub.ts';
+import { ProviderSettings } from '../../src/providers/webui/settings.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { ProviderRegistry } from '../../src/providers/registry.ts';
+import { ProviderModels } from '../../src/providers/models.ts';
+import { readProviders } from '../../src/providers/store.ts';
+import { modelOptions } from '../../src/providers/model-hub.ts';
+import { decodeGeneratedImage } from '../../src/providers/image-generation.ts';
+
+const png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aT1sAAAAASUVORK5CYII=';
+it('image models stay separate from chat and return authenticated image bytes', async () => {
+  const tmp = makeTmpDir(); let body: any, auth: unknown;
+  const server = createServer(async (req, res) => {
+    const chunks: Buffer[] = []; for await (const c of req) chunks.push(c);
+    body = JSON.parse(Buffer.concat(chunks).toString()); auth = req.headers.authorization;
+    res.setHeader('Content-Type', 'application/json'); res.end(JSON.stringify({ data: [{ b64_json: png }] }));
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const root = join(tmp.dir, 'providers'); mkdirSync(join(root, 'local'), { recursive: true });
+  writeFileSync(join(root, 'local', 'config.json'), JSON.stringify({ kind: 'openai-responses-compat', baseUrl: `http://127.0.0.1:${(server.address() as any).port}`, secret: 'LOCAL_KEY', models: { draw: { type: 'image' }, disabled: { type: 'image', enabled: false } } }));
+  writeFileSync(join(root, 'local', '.env'), 'LOCAL_KEY=fixture-key');
+  const registry = new ProviderRegistry(() => readProviders(root), { stateRoot: root, readBlob: () => null, keepThinking: () => true, log: nullLogger() });
+  try {
+    const hub = new ProviderModels(root, () => registry);
+    expect(readProviders(root)).toEqual({});
+    expect(modelOptions(hub, 'models:image')).toEqual([{ value: 'local/draw', label: 'local/draw' }]);
+    expect(hub.list('chat')).toEqual([]);
+    const result = await hub.generateImage('local/draw', 'a circle');
+    expect(result.images[0]).toEqual({ bytes: Buffer.from(png, 'base64'), mime: 'image/png' });
+    expect(body).toEqual({ model: 'draw', prompt: 'a circle', n: 1 }); expect(auth).toBe('Bearer fixture-key');
+    await expect(hub.generateImage('local/disabled', 'a circle')).rejects.toThrow('停用');
+    await expect(hub.generateImage('local/draw', '')).rejects.toThrow('prompt');
+    await expect(hub.generateImage('local/draw', 'a', { signal: AbortSignal.abort() })).rejects.toThrow();
+  } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); tmp.cleanup(); }
+});
+it.each(['https://example.invalid/image.png', 'AAAA', 'bad!', ''])('rejects non-image result %s', value => {
+  expect(() => decodeGeneratedImage(value)).toThrow();
+});
+it('saves supplier options with revision protection and adds image models', () => {
+  const tmp = makeTmpDir(); const root = join(tmp.dir, 'providers'); mkdirSync(root);
+  const file = join(tmp.dir, 'config.json'); writeFileSync(file, '{}');
+  const cfg = makeCfg({ providers: {}, activeProvider: '' });
+  const registry = new ProviderRegistry(() => cfg.providers, { stateRoot: root, readBlob: () => null, keepThinking: () => true, log: nullLogger() });
+  const hub = new ProviderHub(cfg, registry, new ProviderSettings(cfg, registry, file, root), file, root);
+  try {
+    hub.createSource({ name: 'local', kind: 'openai-responses-compat', baseUrl: 'https://example.invalid' }, 'en');
+    const revision = hub.sources('en').sources[0].revision;
+    hub.saveSource('local', { expectedRevision: revision, options: { imageControllerModel: 'controller' } }, 'en');
+    expect(hub.sources('en').sources[0].connection.options).toEqual({ imageControllerModel: 'controller' });
+    expect(() => hub.saveSource('local', { expectedRevision: revision, options: {} }, 'en')).toThrow('changed');
+    hub.addModels('local', { expectedRevision: hub.sources('en').sources[0].revision, models: [{ id: 'draw', type: 'image' }] }, 'en');
+    expect(hub.sources('en').sources[0].models[0].type).toBe('image');
+  } finally { tmp.cleanup(); }
+});
