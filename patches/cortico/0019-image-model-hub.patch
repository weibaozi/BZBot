+  async generateImage(ref: string, prompt: string, options: ImageGenerationOptions = {}): Promise<ImageGenerationResult> {
+    if (!prompt.trim() || prompt.length > 32000) throw new Error('Image prompt must contain 1–32000 characters');
+    const seconds = options.timeoutSeconds ?? 180;
+    if (!Number.isFinite(seconds) || seconds < 1 || seconds > 3600) throw new Error('Image timeout must be 1–3600 seconds');
+    const model = this.find(ref, 'image');
+    const signal = AbortSignal.any([AbortSignal.timeout(seconds * 1000), ...(options.signal ? [options.signal] : [])]);
+    const instance = this.registry().preview(ref, model.entry, true);
+    if (instance.generateImage) return instance.generateImage({ ...options, model: this.modelName(model), prompt, signal });
+    const res = await this.fetchImpl(model.entry.baseUrl.replace(/\/+$/, '') + '/images/generations', {
+      method: 'POST', redirect: 'error', headers: this.headers(model, true), signal,
+      body: JSON.stringify({ model: this.modelName(model), prompt, n: 1, ...(options.size ? { size: options.size } : {}) }),
+    });
+    if (!res.ok) throw new Error(`${ref} image generation failed (HTTP ${res.status})`);
+    const body = await res.json() as { data?: Array<{ b64_json?: string }> };
+    if (!body.data?.length || body.data.length > 4) throw new Error('Image generation returned no usable images');
+    return { images: body.data.map(item => decodeGeneratedImage(item.b64_json)) };
+  }
