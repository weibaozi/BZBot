new file mode 100644
index 0000000..a25eb71
--- /dev/null
+++ b/src/providers/image-generation.ts
@@ -0,0 +1,17 @@
+import type { LLMUsage } from '../core/types.ts';
+
+export interface ImageGenerationOptions { signal?: AbortSignal; size?: string; timeoutSeconds?: number }
+export interface ImageGenerationRequest extends ImageGenerationOptions { model: string; prompt: string }
+export interface ImageGenerationResult { images: Array<{ bytes: Uint8Array; mime: string }>; usage?: LLMUsage }
+
+/** Only image bytes are accepted; never follow a provider-supplied URL with credentials. */
+export function decodeGeneratedImage(value: unknown): { bytes: Uint8Array; mime: string } {
+  if (typeof value !== 'string' || !value.length || value.length > 48_000_000 || !/^[A-Za-z0-9+/]*={0,2}$/.test(value))
+    throw new Error('Invalid or oversized generated image');
+  const bytes = Buffer.from(value, 'base64');
+  const mime = bytes.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])) ? 'image/png'
+    : bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255 ? 'image/jpeg'
+    : bytes.toString('ascii', 0, 4) === 'RIFF' && bytes.toString('ascii', 8, 12) === 'WEBP' ? 'image/webp' : '';
+  if (!mime) throw new Error('Unsupported generated image format');
+  return { bytes, mime };
+}
