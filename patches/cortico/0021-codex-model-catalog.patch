+import type { ListedModel } from '../base.ts';
+
+/** OpenAI data/id and Codex models/slug catalogs describe models without changing connection settings. */
+export function parseModelCatalog(value: unknown): ListedModel[] {
+  const body = value as { data?: unknown; models?: unknown } | null;
+  const codex = !Array.isArray(body?.data) && Array.isArray(body?.models);
+  const rows = codex ? body!.models : body?.data;
+  if (!Array.isArray(rows)) throw new Error('GET /models returned neither a data array nor a models array');
+  const models: ListedModel[] = [];
+  for (const item of rows) {
+    if (!item || typeof item !== 'object') continue;
+    const row = item as Record<string, unknown>;
+    const id = codex ? row.slug : row.id;
+    if (typeof id !== 'string' || !id.trim()) continue;
+    if (codex && (row.supported_in_api === false || row.visibility === 'hidden')) continue;
+    const model: ListedModel = { id };
+    const name = codex ? row.display_name : row.name;
+    if (typeof name === 'string' && name.trim()) model.displayName = name;
+    const window = codex ? row.context_window : row.context_length;
+    if (typeof window === 'number' && Number.isInteger(window) && window > 0) model.contextWindow = window;
+    const output = (row.top_provider as { max_completion_tokens?: unknown } | null)?.max_completion_tokens;
+    if (typeof output === 'number' && Number.isInteger(output) && output > 0) model.maxOutputTokens = output;
+    const modalities = codex ? row.input_modalities : (row.architecture as { input_modalities?: unknown } | null)?.input_modalities;
+    if (Array.isArray(modalities)) model.inputImages = modalities.includes('image');
+    models.push(model);
+  }
+  return models.sort((a, b) => a.id.localeCompare(b.id));
+}
