+++ b/tests/providers/catalog.test.ts
@@ -0,0 +1,33 @@
+import { expect, it } from 'vitest';
+import { createServer } from 'node:http';
+import { ModelCatalog } from '../../src/providers/openai-responses-compat/native.ts';
+import { parseModelCatalog } from '../../src/providers/openai-responses-compat/catalog.ts';
+
+it('reads a Codex catalog through real HTTP and preserves model metadata', async () => {
+  const seen: string[] = [];
+  const server = createServer((req, res) => {
+    seen.push(`${req.method} ${req.url} ${req.headers.authorization}`);
+    res.setHeader('Content-Type', 'application/json');
+    res.end(JSON.stringify({ models: [
+      { slug: 'vision', display_name: 'Vision model', context_window: 1048576, input_modalities: ['text', 'image'], supported_in_api: true, visibility: 'list' },
+      { slug: 'text', context_window: 204800, input_modalities: ['text'] },
+      { slug: 'hidden', visibility: 'hidden' }, { slug: 'unavailable', supported_in_api: false }, null,
+    ] }));
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  try {
+    const baseUrl = `http://127.0.0.1:${(server.address() as { port: number }).port}/v1/`;
+    const catalog = new ModelCatalog(() => ({ baseUrl, headers: { Authorization: 'Bearer fixture' } }));
+    expect(await catalog.list()).toEqual([
+      { id: 'text', contextWindow: 204800, inputImages: false },
+      { id: 'vision', displayName: 'Vision model', contextWindow: 1048576, inputImages: true },
+    ]);
+    expect(catalog.contextWindow('vision')).toBe(1048576);
+    expect(seen).toEqual(['GET /v1/models Bearer fixture']);
+  } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); }
+});
+it('keeps OpenAI metadata and rejects error envelopes', () => {
+  expect(parseModelCatalog({ data: [{ id: 'a', name: 'A', context_length: 4096, top_provider: { max_completion_tokens: 512 }, architecture: { input_modalities: ['image'] } }] })).toEqual([{ id: 'a', displayName: 'A', contextWindow: 4096, maxOutputTokens: 512, inputImages: true }]);
+  expect(() => parseModelCatalog({ error: 'denied' })).toThrow('array');
+  expect(parseModelCatalog({ models: [] })).toEqual([]);
+});
