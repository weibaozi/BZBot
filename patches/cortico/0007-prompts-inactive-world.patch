diff --git a/tests/prompts-inactive-world.test.ts b/tests/prompts-inactive-world.test.ts
new file mode 100644
index 0000000..efd21c5
--- /dev/null
+++ b/tests/prompts-inactive-world.test.ts
@@ -0,0 +1,47 @@
+/**
+ * 提示词页列出全部 World 的环境模板以便提前编辑;没挂载的 World 的模板标出来,它不进前缀。
+ */
+import { afterAll, beforeAll, expect, it } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { createBot, type Bot } from '../src/bot.ts';
+import { loadDeployment } from '../src/deploy.ts';
+import { FakeLLM } from './core/helpers.ts';
+import { withWorlds } from '../src/world.ts';
+import { loadBuiltinWorlds } from '../src/worlds/index.ts';
+import cormini, { type CorminiConfig } from '../bots/cormini/index.ts';
+
+const definition = withWorlds(cormini, await loadBuiltinWorlds());
+let dir: string;
+let bot: Bot<CorminiConfig>;
+let port: number;
+
+beforeAll(async () => {
+  dir = mkdtempSync(join(tmpdir(), 'prompts-inactive-'));
+  const loaded = loadDeployment(definition, dir, resolve(import.meta.dirname, '..'));
+  loaded.config.web.port = 0;
+  loaded.config.worlds.console.enabled = true;
+  loaded.config.worlds.qq.enabled = false;
+  bot = createBot(loaded, { ...definition, build: (l, worlds) => ({ ...definition.build(l, worlds), llm: new FakeLLM() }) });
+  port = (await bot.start()).port as number;
+}, 20000);
+
+afterAll(async () => {
+  await bot.stop();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+it('marks the templates of a World that is not mounted, and only those', async () => {
+  const get = async (path: string) => (await fetch(`http://127.0.0.1:${port}${path}`)).json() as Promise<Record<string, any>>;
+  const prompts = (await get('/api/prompts')).prompts as Array<{ key: string; role?: string; inactive?: boolean }>;
+  const envOf = (world: string) => prompts.find((doc) => doc.role === 'envPrompt' && doc.key.startsWith(`worlds.${world}.`));
+  expect(envOf('qq')).toMatchObject({ inactive: true });
+  expect(envOf('console')).toBeDefined();
+  expect(envOf('console')).not.toHaveProperty('inactive');
+  // Every World-owned template of an unmounted World is marked; templates outside any World never are.
+  expect(prompts.filter((doc) => doc.key.startsWith('worlds.qq.')).every((doc) => doc.inactive === true)).toBe(true);
+  expect(prompts.filter((doc) => !doc.key.startsWith('worlds.')).every((doc) => !('inactive' in doc))).toBe(true);
+  const segments = (await get('/api/prompts/prefix')).segments as Array<{ sourceKey?: string }>;
+  expect(segments.some((segment) => segment.sourceKey === envOf('qq')!.key)).toBe(false);
+});
