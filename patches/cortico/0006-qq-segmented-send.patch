+import { expect, it } from 'vitest';
+import { SEGMENT_DEFAULTS, segmentDelayMs, splitText, type SegmentRule } from '../../../src/worlds/qq/segment.ts';
+
+const on = (patch: Partial<SegmentRule> = {}): SegmentRule => ({ ...SEGMENT_DEFAULTS().private, ...patch });
+
+it('the default pattern cuts after sentence-ending marks and keeps them, with the tail as its own part', () => {
+  expect(splitText('今天好累。你呢？我先睡了！！明天见', on())).toEqual(['今天好累。', '你呢？', '我先睡了！！', '明天见']);
+  expect(splitText('嗯……好吧~那就这样', on())).toEqual(['嗯……', '好吧~', '那就这样']);
+});
+
+it('keeps the text whole when the rule is off, the text is too long, or only one part comes out', () => {
+  expect(splitText('一。二。', on({ enabled: false }))).toEqual(['一。二。']);
+  expect(splitText('一。二。', on({ maxChars: 3 }))).toEqual(['一。二。']);
+  expect(splitText('一。二。', on({ maxChars: 4 }))).toEqual(['一。', '二。']);
+  expect(splitText('没有标点的一句话', on())).toEqual(['没有标点的一句话']);
+  expect(splitText('', on())).toEqual(['']);
+});
+
+it('words mode cuts after each split word and drops it, longest word first', () => {
+  expect(splitText('好的。走吧！嗯', on({ mode: 'words' }))).toEqual(['好的', '走吧', '嗯']);
+  expect(splitText('a--b-c', on({ mode: 'words', words: '- --' }))).toEqual(['a', 'b', 'c']);
+  expect(splitText('好的。走吧', on({ mode: 'words', words: '  ' }))).toEqual(['好的。走吧']);
+});
+
+it('the removal pattern cleans each part, and parts left empty are dropped', () => {
+  expect(splitText('好呀。真的吗？。', on({ cleanup: '[。？！]' }))).toEqual(['好呀', '真的吗']);
+});
+
+it('an invalid split pattern falls back to the default and an invalid removal pattern removes nothing', () => {
+  expect(splitText('一。二。', on({ regex: '(' }))).toEqual(['一。', '二。']);
+  expect(splitText('一。二。', on({ cleanup: '[' }))).toEqual(['一。', '二。']);
+});
+
+it('pauses fall within the random range, or follow the word count on the log method', () => {
+  expect(segmentDelayMs('x', on({ interval: [1.5, 3.5] }), () => 0)).toBe(1500);
+  expect(segmentDelayMs('x', on({ interval: [1.5, 3.5] }), () => 1)).toBe(3500);
+  expect(segmentDelayMs('x', on({ interval: [3, 1] }), () => 0)).toBe(1000);
+  // 7 characters of Chinese: log_2.6(8) ≈ 2.176 s, plus up to half a second.
+  expect(segmentDelayMs('今天天气很好。', on({ intervalMethod: 'log' }), () => 0)).toBe(Math.round(Math.log(7) / Math.log(2.6) * 1000));
+  expect(segmentDelayMs('good night all', on({ intervalMethod: 'log', logBase: 2 }), () => 1)).toBe(2500);
+});
