+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { LANGUAGES } from '../../src/core/language.ts';
+import { qqConfigGroup } from '../../src/worlds/qq/config.ts';
+import { MockOneBot } from '../helpers/mock-onebot.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir, sleep } from '../core/helpers.ts';
+
+async function fixture() {
+  const tmp = makeTmpDir();
+  const mock = new MockOneBot({ port: 0, groupId: 424242 });
+  const port = await mock.start();
+  const cfg = makeCfg();
+  cfg.worlds.qq = { ...cfg.worlds.qq, enabled: true, wsUrl: `ws://127.0.0.1:${port}`,
+    groups: [{ id: 424242, enabled: true }], privates: [{ id: 1001, enabled: true }] };
+  // Pauses short enough for a test, long enough to see they happen between parts.
+  cfg.worlds.qq.segment.private.interval = [0.05, 0.05];
+  cfg.worlds.qq.segment.group.interval = [0.05, 0.05];
+  cfg.worlds.console.enabled = false; cfg.web.port = 0;
+  cfg.tick.dayIntervalMinutes = [999, 999]; cfg.tick.nightIntervalMinutes = null;
+  const memoryDir = join(tmp.dir, 'memory'); mkdirSync(memoryDir, { recursive: true });
+  writeFileSync(join(memoryDir, 'CONSTITUTION.md'), 'Fixture persona');
+  const bot = assembleBot(makeLoaded({ config: cfg, rootDir: tmp.dir, memoryDir, dataDir: join(tmp.dir, 'data') }), { llm: new FakeLLM() });
+  bot.core.bus.setPaused(true);
+  await bot.start(); await bot.qqWorld!.waitReady(5000);
+  const tool = (name: string) => bot.qqWorld!.tools().find(t => t.name === name)!;
+  const ctx = { role: 'main', log: nullLogger() };
+  const incoming = async (kind: 'group' | 'private') => {
+    const message = { user_id: 1001, nickname: 'fixture', text: 'hello' };
+    const mid = kind === 'group' ? mock.emitGroupMessage(message) : mock.emitPrivateMessage(message);
+    const deadline = Date.now() + 5000;
+    while (!bot.core.store.range({}).some(e => e.meta?.message_id === mid) && Date.now() < deadline) await sleep(20);
+    return mid;
+  };
+  const self = () => bot.core.store.range({}).filter(e => e.type === 'qq.self');
+  const done = async () => { await bot.stop(); await mock.close(); tmp.cleanup(); };
+  return { cfg, mock, tool, ctx, incoming, self, done, memoryDir };
+}
+
+it('a private reply goes out as one message per sentence, quoting only the first, with a pause between', async () => {
+  const { cfg, mock, tool, ctx, incoming, self, done } = await fixture();
+  try {
+    cfg.worlds.qq.quoteReply = true;
+    const mid = await incoming('private');
+    const staged = await tool('qq_draft').handler({ text: '今天好累。你呢？我先睡了', reply_to: String(mid) }, ctx);
+    expect(staged).toContain('Will be sent as 3 messages with short pauses: 「今天好累。」 「你呢？」 「我先睡了」');
+    const started = Date.now();
+    const receipt = await tool('qq_confirm').handler({ decision: 'send' }, ctx);
+    expect(Date.now() - started).toBeGreaterThanOrEqual(90);
+    const ids = mock.outbox.map(entry => entry.message_id);
+    expect(receipt).toBe(`[sent as 3 messages ${ids.map(id => `#${id}`).join(' ')} → 私聊 fixture]`);
+    expect(mock.outbox.map(entry => entry.params.message)).toEqual([
+      [{ type: 'reply', data: { id: String(mid) } }, { type: 'text', data: { text: '今天好累。' } }],
+      [{ type: 'text', data: { text: '你呢？' } }],
+      [{ type: 'text', data: { text: '我先睡了' } }],
+    ]);
+    expect(self().map(e => e.meta?.message_id)).toEqual(ids);
+    expect(self().map(e => e.text.replace(/^#\d+ \[[^\]]+\] /, ''))).toEqual(['你: 今天好累。', '你: 你呢？', '你: 我先睡了']);
+  } finally { await done(); }
+}, 15000);
+
+it('groups send whole by default and split once their rule is switched on, read at send time', async () => {
+  const { cfg, mock, tool, ctx, incoming, done } = await fixture();
+  try {
+    await incoming('group');
+    const draft = () => tool('qq_draft').handler({ to: 'group:424242', text: '好。走吧' }, ctx);
+    expect(await draft()).not.toContain('Will be sent as');
+    expect(await tool('qq_confirm').handler({ decision: 'send' }, ctx)).toMatch(/^\[sent #\d+ → 群「测试群」\]$/);
+    await draft(); cfg.worlds.qq.segment.group.enabled = true;
