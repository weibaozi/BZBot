+    expect(mock.outbox.map(entry => (entry.params.message as Array<{ type: string }>).map(segment => segment.type))).toEqual([['text'], ['image', 'text']]);
+    expect(self().at(-1)!.text).toContain('猫 [图片: mem:external/qq/images/cat.png]');
