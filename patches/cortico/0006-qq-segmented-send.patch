@@ -0,0 +1,89 @@
+/**
+ * 分段发送:一份确认发出的草稿按会话类型的规则切成几条 QQ 消息,条与条之间停一会儿。
+ * 规则与默认值照 AstrBot 的分段回复:按正则或分段词切,切后可按正则删去指定内容;
+ * 间隔取随机区间,或按字数取对数。超过字数上限的正文整条发出,不切。
+ */
+
+/** 一类会话(私聊或群聊)的分段规则。 */
+export interface SegmentRule {
+  enabled: boolean;
+  /** 正文字数(按字符计)不超过它才分段;更长的整条发出。 */
+  maxChars: number;
+  /** `regex` 按 `regex` 取每一段;`words` 切在 `words` 里的分段词之后,分段词本身去掉。 */
+  mode: 'regex' | 'words';
+  regex: string;
+  /** 分段词,以空格分开。 */
+  words: string;
+  /** 每段删去匹配它的内容;空串不删。 */
+  cleanup: string;
+  /** `random` 在 `interval` 区间里随机;`log` 取 log_logBase(字数 + 1) 秒再加 0–0.5 秒。 */
+  intervalMethod: 'random' | 'log';
+  /** 随机间隔的上下限,单位秒。 */
+  interval: [number, number];
+  logBase: number;
+}
+
+export interface SegmentConfig {
+  private: SegmentRule;
+  group: SegmentRule;
+}
+
+export const DEFAULT_SEGMENT_REGEX = '.*?[。？！~…]+|.+$';
+
+const rule = (enabled: boolean): SegmentRule => ({
+  enabled, maxChars: 150, mode: 'regex', regex: DEFAULT_SEGMENT_REGEX, words: '。 ？ ！ ~ …', cleanup: '',
+  intervalMethod: 'random', interval: [1.5, 3.5], logBase: 2.6,
+});
+
+/** 私聊默认分段,群聊默认整条发。 */
+export const SEGMENT_DEFAULTS = (): SegmentConfig => ({ private: rule(true), group: rule(false) });
+
+/** 写错的正则当作没写:分段退回默认正则,删除规则不删。 */
+function compile(source: string, flags: string): RegExp | null {
+  try { return new RegExp(source, flags); } catch { return null; }
+}
+
+/**
+ * 把正文切成要发的几段。规则关闭、正文超过字数上限或切不出两段时,返回原文一段。
+ * 段首尾空白去掉,空段丢弃。
+ */
+export function splitText(text: string, rule: SegmentRule): string[] {
+  if (!rule.enabled || !text.trim() || [...text].length > rule.maxChars) return [text];
+  let parts: string[];
+  if (rule.mode === 'words') {
+    const words = rule.words.split(/\s+/).filter(Boolean).sort((a, b) => b.length - a.length);
+    if (!words.length) return [text];
+    const alternatives = words.map(word => word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
+    parts = [...text.matchAll(new RegExp(`.*?(?:${alternatives})|.+$`, 'gs'))].map(match => {
+      const part = match[0];
+      const word = words.find(candidate => part.endsWith(candidate));
+      return word ? part.slice(0, -word.length) : part;
+    });
+  } else {
+    const pattern = compile(rule.regex, 'gms') ?? new RegExp(DEFAULT_SEGMENT_REGEX, 'gms');
+    parts = [...text.matchAll(pattern)].map(match => match[0]);
+  }
+  const cleanup = rule.cleanup ? compile(rule.cleanup, 'g') : null;
+  const segments = parts.map(part => (cleanup ? part.replace(cleanup, '') : part).trim()).filter(Boolean);
+  return segments.length > 1 ? segments : [text];
+}
+
+/** 字数:纯 ASCII 按空白分词计,否则数字母和数字(含汉字)。 */
+function wordCount(text: string): number {
+  // eslint-disable-next-line no-control-regex
+  if (/^[\x00-\x7f]*$/.test(text)) return text.split(/\s+/).filter(Boolean).length;
+  return [...text].filter(char => /[\p{L}\p{N}]/u.test(char)).length;
+}
+
+/** 发这一段之前等多久,单位毫秒。 */
+export function segmentDelayMs(segment: string, rule: SegmentRule, random: () => number = Math.random): number {
+  if (rule.intervalMethod === 'log') {
+    const base = Number.isFinite(rule.logBase) && rule.logBase > 1 ? rule.logBase : 2.6;
+    const seconds = Math.log(wordCount(segment) + 1) / Math.log(base);
+    return Math.round((seconds + random() * 0.5) * 1000);
+  }
+  const [low, high] = rule.interval;
+  const min = Math.max(0, Math.min(low, high));
+  const max = Math.max(0, low, high);
+  return Math.round((min + random() * (max - min)) * 1000);
+}
