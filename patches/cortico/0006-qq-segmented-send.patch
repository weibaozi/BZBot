+    ]);
+  } finally { await done(); }
+}, 15000);
+
+it('a failure after the first part reports what went out and drops the draft; a failure on the first keeps it', async () => {
+  const { mock, tool, ctx, incoming, self, done } = await fixture();
+  try {
+    await incoming('private');
+    let calls = 0;
+    mock.setActionHandler('send_private_msg', () => (++calls === 2 ? { retcode: 1200, message: 'rate limited' } : { data: { message_id: 7000 + calls } }));
+    await tool('qq_draft').handler({ to: 'private:1001', text: '一。二。三' }, ctx);
+    const receipt = await tool('qq_confirm').handler({ decision: 'send' }, ctx);
+    expect(receipt).toContain('[send failed on part 2 of 3 → 私聊 fixture] send_private_msg: retcode=1200 rate limited');
+    expect(receipt).toContain('Parts already sent: #7001. The rest was not sent');
+    expect(self().map(e => e.meta?.message_id)).toEqual([7001]);
+    expect(await tool('qq_confirm').handler({ decision: 'send' }, ctx)).toContain('no draft to confirm');
+
+    mock.setActionHandler('send_private_msg', () => ({ retcode: 1200, message: 'offline' }));
+    await tool('qq_draft').handler({ to: 'private:1001', text: '一。二。' }, ctx);
+    expect(await tool('qq_confirm').handler({ decision: 'send' }, ctx)).toContain('draft kept; confirm again to retry or cancel');
+    expect(await tool('qq_confirm').handler({ decision: 'cancel' }, ctx)).toContain('draft discarded');
+  } finally { await done(); }
+}, 15000);
+
+it('an image rides with the last part', async () => {
+  const { mock, tool, ctx, incoming, self, done, memoryDir } = await fixture();
+  try {
+    await incoming('private');
+    const images = join(memoryDir, 'external', 'qq', 'images'); mkdirSync(images, { recursive: true });
+    writeFileSync(join(images, 'cat.png'), Buffer.from('89504e470d0a1a0a0000000d49484452', 'hex'));
+    expect(await tool('qq_draft').handler({ to: 'private:1001', text: '看。猫', image: 'mem:external/qq/images/cat.png' }, ctx)).toContain('Will be sent as 2 messages');
