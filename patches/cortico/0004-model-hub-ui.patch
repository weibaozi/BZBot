+/** 读一个目录的供应商视图;旧格式按 `sourceFromEntry` 换算,`legacy` 标明磁盘上仍是旧格式。 */
+export function readSource(root: string, source: string): { source: ProviderSource; legacy: boolean } | null {
+  if (!existsSync(join(root, source, 'config.json'))) return null;
+  const raw = readConfig(root, source);
+  return isProviderSource(raw) ? { source: raw, legacy: false } : { source: sourceFromEntry(raw as LLMProviderEntry), legacy: true };
+}
+
+/** 整份写一个供应商目录的 `config.json`,目录里的密钥与 provider 状态保留。返回写后展开的端点表。 */
+export function writeSource(root: string, source: string, file: ProviderSource): Record<string, LLMProviderEntry> {
+  mkdirSync(join(root, source), { recursive: true });
+  updateJsonObject(join(root, source, 'config.json'), (raw) => {
+    for (const key of Object.keys(raw)) delete raw[key];
+    Object.assign(raw, structuredClone(file));
+  });
+  return flattenSource(source, file);
+}
