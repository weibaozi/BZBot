+/** 旧格式端点换成只有一个对话模型的供应商;模型 id 取 `spec.model`,没选模型时为 `default`。 */
+export function sourceFromEntry(entry: LLMProviderEntry): ProviderSource {
+  const { spec, pricing, multimodal, serviceTier, ...shared } = structuredClone(entry);
+  const id = spec?.model || 'default';
+  const model: SourceModel = { type: 'chat' };
+  if (spec) model.spec = spec;
+  if (pricing) model.pricing = pricing;
+  if (multimodal !== undefined) model.multimodal = multimodal;
+  if (serviceTier !== undefined) model.serviceTier = serviceTier;
+  return { ...shared, models: { [id]: model } };
+}
