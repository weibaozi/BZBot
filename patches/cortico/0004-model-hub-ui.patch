+import { matchingEfforts } from '../../../../providers/effort-presets.ts';
+import type { WebUi } from '../../../shared/client-panel.ts';
+import type { Detail, Module } from './types.ts';
+import { S } from './strings.ts';
+
+/** Defaults apply only when creating an endpoint, never when opening an existing one. */
+export const GENERATION_DEFAULTS = { maxTokens: 8192, contextWindow: 1_000_000 } as const;
+
+export function newModelSpec(module?: Pick<Module, 'reasoningTiers'>): NonNullable<Detail['entry']['spec']> {
+  const tier = module?.reasoningTiers[0];
+  return { model: '', thinking: tier?.thinking ?? true,
+    ...(tier?.effort ? { reasoningEffort: tier.effort } : {}), ...GENERATION_DEFAULTS };
+}
+
+/** Refreshing choices preserves the stored value; changing a choice alone changes the spec. */
+export function reasoningControl(ui: WebUi, module: Pick<Module, 'reasoningTiers' | 'effortSuggestions' | 'effortPresets'>,
+  entry: Detail['entry'], changed: () => void) {
+  const spec = entry.spec!;
+  const box = ui.h('div');
+  const note = ui.msgline();
+  const custom = ui.input({ value: spec.reasoningEffort ?? '' });
+  custom.setAttribute('aria-label', S.customEffort);
+  const select = ui.select({ options: [], onChange: value => {
+    if (module.reasoningTiers.length) {
+      const tier = module.reasoningTiers.find(item => item.id === value)!;
+      spec.thinking = tier.thinking;
+      if (tier.effort) spec.reasoningEffort = tier.effort; else delete spec.reasoningEffort;
+    } else if (value === 'custom') {
+      custom.hidden = false; custom.focus(); return;
+    } else {
+      spec.thinking = value !== 'none';
+      if (value && value !== 'none') spec.reasoningEffort = value; else delete spec.reasoningEffort;
+    }
+    refresh(); changed();
+  } });
+  select.setAttribute('aria-label', S.reasoning);
+  custom.addEventListener('input', () => {
+    spec.thinking = custom.value.trim() !== 'none';
+    if (custom.value.trim() && spec.thinking) spec.reasoningEffort = custom.value.trim(); else delete spec.reasoningEffort;
+    changed();
+  });
+  box.append(ui.field(S.reasoning, select), custom, note);
+  function refresh() {
+    const current = spec.thinking ? spec.reasoningEffort ?? '' : 'none';
+    const known = matchingEfforts(module.effortPresets ?? [], entry.baseUrl, spec.model);
+    const tiers = module.reasoningTiers;
+    const selectedTier = tiers.find(tier => tier.thinking === spec.thinking && tier.effort === spec.reasoningEffort);
+    const choices = tiers.length ? tiers.map(tier => ({ value: tier.id, label: tier.label }))
+      : [{ value: '', label: S.modelDefault }, ...(known ?? (module.effortSuggestions?.length ? module.effortSuggestions : ['none', 'low', 'medium', 'high']))
+        .map(value => ({ value, label: value === 'none' ? S.noThinking : value }))];
+    const selected = tiers.length ? selectedTier?.id ?? current : current;
+    const unsupported = !choices.some(choice => choice.value === selected);
+    if (unsupported) choices.push({ value: selected, label: S.currentEffort(selected) });
+    if (!tiers.length && known === undefined) choices.push({ value: 'custom', label: S.customEffort });
+    select.replaceChildren(...choices.map(choice => {
+      const option = ui.h('option'); option.value = choice.value; option.textContent = choice.label; return option;
+    }));
+    select.value = selected;
+    select.setAttribute('aria-invalid', String(unsupported && (known !== undefined || tiers.length > 0)));
+    note.textContent = unsupported && (known !== undefined || tiers.length > 0) ? S.chooseSupportedEffort : '';
+    note.classList.toggle('bad', !!note.textContent);
+    custom.hidden = true;
+    custom.value = spec.reasoningEffort ?? '';
+  }
+  refresh();
+  return { el: box, refresh, valid: () => select.getAttribute('aria-invalid') !== 'true' };
+}
