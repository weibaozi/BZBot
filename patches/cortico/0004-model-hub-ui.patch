index 0000000..44ab9c3
--- /dev/null
+++ b/src/providers/effort-presets.ts
@@ -0,0 +1,14 @@
+/** Provider-owned effort names, scoped to an endpoint and exact model aliases or dated snapshots. */
+export interface EffortPreset {
+  host: string;
+  models: readonly string[];
+  efforts: readonly string[];
+}
+
+export function matchingEfforts(presets: readonly EffortPreset[], baseUrl: string, model: string): readonly string[] | undefined {
+  let host: string;
+  try { host = new URL(baseUrl).hostname; } catch { return undefined; }
+  return presets.find(preset => preset.host === host && preset.models.some(alias =>
+    model === alias || (model.startsWith(alias + '-') && /^\d{4}-\d{2}-\d{2}$/.test(model.slice(alias.length + 1))),
+  ))?.efforts;
+}
