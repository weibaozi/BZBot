+/** A real HTTP listener and ProviderHub persist the form; no running deployment or external service is used. */
+async function editor(existing?: Detail['entry']) {
+  const temp = makeTmpDir(); cleanups.push(temp.cleanup);
+  const rootDir = join(temp.dir, 'providers'); mkdirSync(rootDir);
+  const file = join(temp.dir, 'config.json'); writeFileSync(file, '{}');
+  const cfg = makeCfg({ providers: {}, activeProvider: '' });
+  const registry = new ProviderRegistry(() => cfg.providers, { stateRoot: rootDir, readBlob: () => null, keepThinking: () => true, log: nullLogger() });
+  const hub = new ProviderHub(cfg, registry, new ProviderSettings(cfg, registry, file, rootDir), file, rootDir);
+  const saved = existing ? hub.save(null, { name: 'Sample', entry: existing }, 'zh') : null;
+  const server = createServer(async (req, res) => {
+    try {
+      let raw = ''; for await (const chunk of req) raw += chunk;
+      const body = JSON.parse(raw || '{}');
+      const result = req.url === '/api/provider-modules/config' ? hub.groups(body.name, body.entry, 'zh')
+        : req.url === '/api/providers' ? hub.save(null, body, 'zh')
+        : req.url === '/api/providers/Sample/save' ? hub.save('Sample', body, 'zh') : null;
+      res.setHeader('Content-Type', 'application/json'); res.end(JSON.stringify(result));
+    } catch (error) { res.statusCode = 400; res.end(JSON.stringify({ error: String(error) })); }
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  cleanups.push(() => new Promise<void>(resolve => { server.close(() => resolve()); server.closeAllConnections(); }));
+  const address = server.address() as { port: number };
+  const fetchHttp = globalThis.fetch;
+  vi.stubGlobal('fetch', async (url: string, init?: RequestInit) => {
+    const controller = new NodeAbortController();
+    const abort = () => controller.abort();
+    if (init?.signal?.aborted) abort(); else init?.signal?.addEventListener('abort', abort, { once: true });
+    try { return await fetchHttp(new URL(url, `http://127.0.0.1:${address.port}`), { ...init, signal: controller.signal }); }
+    finally { init?.signal?.removeEventListener('abort', abort); }
+  });
+  const { ui, lifecycle } = widgets();
+  const root = document.createElement('div'); document.body.append(root);
+  const ctx = { root, ui, signal: lifecycle.signal, lifecycle, onError: (error: unknown) => { throw error; } } as unknown as FeatureContext;
+  let changed: Editing | null = null; let savedName = '';
+  const modules = hub.moduleList('zh');
+  await mountDetail({ ctx, root, modules, saved,
+    draft: saved ? null : { original: null, name: 'Sample', entry: { kind: '', baseUrl: '' }, secretValue: '', raw: {} },
+    changed: value => { changed = value; }, onSaved: async name => { savedName = name; }, cancelled: async () => {}, deleted: async () => {}, duplicate: async () => {},
+  }).then(controller => cleanups.push(() => controller.dispose()));
+  return { root, hub, rootDir, changed: () => changed!, savedName: () => savedName };
+}
+it('new endpoint defaults survive a real save and omit temperature on the wire', async () => {
