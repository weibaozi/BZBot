+import { expect, it } from 'vitest';
+import { mkdirSync, writeFileSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { MockOneBot } from '../helpers/mock-onebot.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir, sleep, toolReply, textReply } from '../core/helpers.ts';
+
+it('archives sleeping group messages and authorizes changes only from delivered trusted identities',async()=>{
+ const tmp=makeTmpDir(),mock=new MockOneBot({port:0,groupId:424242,selfId:5000}),llm=new FakeLLM(),cfg=makeCfg();
+ const port=await mock.start(); cfg.globals={trustedQQ:'10001'};
+ cfg.worlds.qq={...cfg.worlds.qq,enabled:true,wsUrl:`ws://127.0.0.1:${port}`,groupReply:{probability:100,recentMessages:5,forceMention:true,sleepEnabled:true,sleepStart:'00:00',sleepEnd:'00:00'},groups:[{id:424242,enabled:true}],privates:[{id:10001,enabled:true},{id:10002,enabled:true}]};
+ cfg.worlds.console.enabled=false;cfg.web.port=0;cfg.tick.dayIntervalMinutes=[999,999];cfg.tick.nightIntervalMinutes=null;cfg.batching.quietGapMs=20;
+ const memoryDir=join(tmp.dir,'memory');mkdirSync(memoryDir);writeFileSync(join(memoryDir,'CONSTITUTION.md'),'Fixture');writeFileSync(join(tmp.dir,'config.json'),'{}');
+ const bot=assembleBot(makeLoaded({config:cfg,rootDir:tmp.dir,memoryDir,dataDir:join(tmp.dir,'data')}),{llm});
+ const call=()=>bot.qqWorld!.tools().find(t=>t.name==='qq_set_group_sleep')!.handler({enabled:false,start:'23:00',end:'08:00'},{role:'main',log:nullLogger()});
+ try{
+  bot.core.bus.setPaused(true);await bot.start();await bot.qqWorld!.waitReady(5000);
+  const group=async(user:number,mention:boolean,text:string)=>{const mid=mock.emitGroupMessage({user_id:user,segments:[...(mention?[{type:'at',data:{qq:'5000'}}]:[]),{type:'text',data:{text}}]});await expect.poll(()=>bot.core.store.range({source:'qq'}).some(e=>e.type==='qq.message'&&e.meta?.message_id===mid)).toBe(true);await sleep(30);};
+  await group(10002,true,'FOREIGN_MENTION');await group(10001,false,'OWNER_NO_MENTION');await group(10002,false,'RANDOM');
+  expect(bot.core.store.range({source:'qq'}).filter(e=>e.type==='qq.group_trigger')).toHaveLength(0);
+  await expect(call()).rejects.toThrow('current request');
+  llm.script(toolReply([{name:'qq_set_group_sleep',args:{enabled:false,start:'23:00',end:'08:00'}}]),textReply(''));
+  cfg.worlds.qq.groupReply.forceMention=false;
+  await group(10001,true,'OWNER_CHANGE');
+  expect(bot.core.store.range({source:'qq'}).filter(e=>e.type==='qq.group_trigger')).toHaveLength(1);
+  bot.core.bus.setPaused(false);
+  await expect.poll(()=>cfg.worlds.qq.groupReply.sleepEnabled,{timeout:7000}).toBe(false);
+  expect(JSON.parse(readFileSync(join(tmp.dir,'config.json'),'utf8')).worlds.qq.groupReply.sleepEnabled).toBe(false);
+  await expect(call()).rejects.toThrow('current request');
+  cfg.worlds.qq.groupReply.sleepEnabled=true;
+  llm.script(toolReply([{name:'qq_set_group_sleep',args:{enabled:false,start:'01:00',end:'06:00'}}]),textReply(''));
+  mock.emitPrivateMessage({user_id:10002,text:'UNTRUSTED_PRIVATE'});
+  await expect.poll(()=>JSON.stringify(llm.calls),{timeout:6000}).toContain('UNTRUSTED_PRIVATE');
+  await sleep(150);expect(cfg.worlds.qq.groupReply.sleepEnabled).toBe(true);
+  llm.script(toolReply([{name:'qq_set_group_sleep',args:{enabled:false,start:'01:00',end:'06:00'}}]),textReply(''));
+  mock.emitPrivateMessage({user_id:10001,text:'TRUSTED_PRIVATE_CHANGE'});
+  await expect.poll(()=>cfg.worlds.qq.groupReply.sleepEnabled,{timeout:6000}).toBe(false);
+ }finally{await bot.stop();await mock.close();tmp.cleanup();}
+},20000);
+
+it('rechecks queued messages and delayed voice transcription when sleep is enabled', async()=>{
+ const tmp=makeTmpDir(),mock=new MockOneBot({port:0,groupId:424242,selfId:5000}),llm=new FakeLLM(),cfg=makeCfg();
+ const port=await mock.start();
+ cfg.worlds.qq={...cfg.worlds.qq,enabled:true,wsUrl:`ws://127.0.0.1:${port}`,groupReply:{probability:100,recentMessages:5,forceMention:true,sleepEnabled:false,sleepStart:'00:00',sleepEnd:'00:00'},groups:[{id:424242,enabled:true}],privates:[{id:10001,enabled:true}]};
+ cfg.worlds.console.enabled=false;cfg.web.port=0;cfg.tick.dayIntervalMinutes=[999,999];cfg.tick.nightIntervalMinutes=null;
+ const memoryDir=join(tmp.dir,'memory');mkdirSync(memoryDir);writeFileSync(join(memoryDir,'CONSTITUTION.md'),'Fixture');
+ const bot=assembleBot(makeLoaded({config:cfg,rootDir:tmp.dir,memoryDir,dataDir:join(tmp.dir,'data')}),{llm});
+ let release!:()=>void,requested=false;
+ const wait=new Promise<void>(resolve=>{release=resolve;});
+ mock.setActionHandler('fetch_ptt_text',async()=>{requested=true;await wait;return {data:{text:'DELAYED_VOICE'}};});
+ try{
+  bot.core.bus.setPaused(true);await bot.start();await bot.qqWorld!.waitReady(5000);
+  mock.emitGroupMessage({user_id:10002,text:'QUEUED_BEFORE_SLEEP'});
+  await expect.poll(()=>bot.core.store.range({source:'qq'}).filter(e=>e.type==='qq.group_trigger').length).toBe(1);
+  const mid=mock.emitGroupMessage({user_id:10002,segments:[{type:'record',data:{file:'fixture-record'}}]});
+  await expect.poll(()=>requested).toBe(true);
+  cfg.worlds.qq.groupReply.sleepEnabled=true;release();
+  await expect.poll(()=>bot.core.store.range({source:'qq'}).some(e=>e.type==='qq.transcript'&&e.meta?.message_id===mid)).toBe(true);
+  bot.core.bus.setPaused(false);mock.emitPrivateMessage({user_id:10001,text:'PRIVATE_CONTROL'});
+  await expect.poll(()=>JSON.stringify(llm.calls),{timeout:6000}).toContain('PRIVATE_CONTROL');
+  expect(bot.core.store.range({source:'qq'}).filter(e=>e.type==='qq.group_context')).toHaveLength(0);
+  expect(JSON.stringify(llm.calls)).not.toContain('QUEUED_BEFORE_SLEEP');
+  expect(JSON.stringify(llm.calls)).not.toContain('DELAYED_VOICE');
+ }finally{release();await bot.stop();await mock.close();tmp.cleanup();}
+},15000);
