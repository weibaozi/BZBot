+import { expect, it } from 'vitest';
+import { sleeping } from '../../src/worlds/qq/group-sleep.ts';
+import { GROUP_REPLY_DEFAULTS } from '../../src/worlds/qq/group-admission.ts';
+import { groupReplyConfigGroup } from '../../src/worlds/qq/group-reply-config.ts';
+import { LANGUAGES } from '../../src/core/language.ts';
+it('uses deployment timezone, midnight and exact boundaries', () => {
+ const cfg={...GROUP_REPLY_DEFAULTS,sleepEnabled:true,sleepStart:'23:00',sleepEnd:'08:00'};
+ for(const [time,expected] of [['22:59',false],['23:00',true],['00:00',true],['07:59',true],['08:00',false]] as const) expect(sleeping(cfg,'UTC',new Date('2026-01-01T'+time+':00Z'))).toBe(expected);
+ expect(sleeping(cfg,'Asia/Shanghai',new Date('2026-01-01T15:00:00Z'))).toBe(true);
+ expect(sleeping({...cfg,sleepStart:'09:00',sleepEnd:'12:00'},'UTC',new Date('2026-01-01T10:00:00Z'))).toBe(true);
+ expect(sleeping({...cfg,sleepStart:'00:00',sleepEnd:'00:00'},'UTC')).toBe(true);
+ expect(sleeping({...cfg,sleepEnabled:false},'UTC')).toBe(false);
+ for(const language of LANGUAGES){const props=groupReplyConfigGroup(language).schema.properties;expect(props['worlds.qq.groupReply.sleepStart'].enum).toContain('23:00');expect(props['worlds.qq.groupReply.sleepEnd'].enum).not.toContain('24:00');}
+});
