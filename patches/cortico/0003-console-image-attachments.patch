diff --git a/tests/integration/console-image-send.test.ts b/tests/integration/console-image-send.test.ts
new file mode 100644
index 0000000..4f57444
--- /dev/null
+++ b/tests/integration/console-image-send.test.ts
@@ -0,0 +1,42 @@
+import { expect, it } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import WebSocket from 'ws';
+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir } from '../core/helpers.ts';
+import { panelStreamRoute } from '../../src/web/shared/webui-protocol.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import type { WorldHost } from '../../src/core/types.ts';
+
+it('console image handles persist, broadcast and replay with QQ disabled; invalid handles send nothing', async () => {
+  const tmp = makeTmpDir(); const cfg = makeCfg(); cfg.worlds.qq.enabled = false; cfg.worlds.console.enabled = true; cfg.web.port = 0;
+  cfg.tick.dayIntervalMinutes = [999, 999]; cfg.tick.nightIntervalMinutes = null;
+  const memoryDir = join(tmp.dir, 'persona'); mkdirSync(memoryDir, { recursive: true }); writeFileSync(join(memoryDir, 'CONSTITUTION.md'), 'Fixture persona');
+  const bot = assembleBot(makeLoaded({ config: cfg, rootDir: tmp.dir, memoryDir, dataDir: join(tmp.dir, 'data') }), { llm: new FakeLLM() });
+  const sockets: WebSocket[] = []; const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl6SAAAAABJRU5ErkJggg==', 'base64');
+  const wait = async (condition: () => boolean) => { const deadline = Date.now() + 5000; while (!condition()) { if (Date.now() > deadline) throw new Error('Timed out'); await new Promise(r => setTimeout(r, 10)); } };
+  try {
+    const port = (await bot.start()).port;
+    const connect = async () => {
+      const messages: Array<{ type: string; text?: string; images?: Array<{ ref: string; mime: string }> }> = [];
+      const ws = new WebSocket(`ws://127.0.0.1:${port}${panelStreamRoute('world:console', 'chat')}`); sockets.push(ws);
+      ws.on('message', bytes => messages.push(JSON.parse(String(bytes))));
+      await new Promise<void>((resolve, reject) => { ws.once('open', resolve); ws.once('error', reject); });
+      ws.send(JSON.stringify({ type: 'hello', name: 'fixture' })); await wait(() => messages.some(m => m.type === 'sys'));
+      return messages;
+    };
+    const messages = await connect(); let host!: WorldHost;
+    await bot.core.mountWorld({ id: 'fixture', envPromptVars: () => null, start: async h => { host = h; }, stop: async () => {}, tools: () => [] });
+    const stored = await host.pushEvent({ type: 'fixture.image', source: 'fixture', text: 'image', ts: new Date().toISOString(), blobs: [{ bytes: png, mime: 'image/png', fallbackText: 'fixture image' }] }, { deliver: false });
+    const send = bot.consoleWorld!.tools()[0]; const context = { role: 'main', log: nullLogger() };
+    expect(await send.handler({ image: 'log:missing.png' }, context)).toContain('[send failed]');
+    expect(bot.core.store.range({}).filter(e => e.type === 'console.self')).toHaveLength(0);
+    expect(await send.handler({ text: 'picture', image: stored.blobs![0].handle }, context)).toContain('[sent]');
+    await wait(() => messages.some(m => m.text === 'picture'));
+    const frame = messages.find(m => m.text === 'picture')!; expect(frame.images?.[0].mime).toBe('image/png');
+    const self = bot.core.store.range({}).find(e => e.type === 'console.self')!; expect(self.blobs?.[0].handle).toBe(frame.images![0].ref);
+    const response = await fetch(`http://127.0.0.1:${port}/api/blob?handle=${encodeURIComponent(frame.images![0].ref)}`);
+    expect(response.ok).toBe(true); expect(Buffer.from(await response.arrayBuffer())).toEqual(png);
+    const replay = await connect(); await wait(() => replay.some(m => m.text === 'picture')); expect(replay.find(m => m.text === 'picture')?.images).toEqual(frame.images);
+  } finally { for (const socket of sockets) socket.terminate(); await bot.stop(); tmp.cleanup(); }
+}, 15000);
