diff --git a/src/worlds/image-sources.ts b/src/worlds/image-sources.ts
new file mode 100644
index 0000000..552e3a9
--- /dev/null
+++ b/src/worlds/image-sources.ts
@@ -0,0 +1,25 @@
+/** Deployment-scoped image references supplied by extensions; no network or path interpretation. */
+import { resolve } from 'node:path';
+export interface SourceImage { bytes: Uint8Array; mime: string }
+export type ImageSource = (id: string) => Promise<SourceImage>;
+const sources = new Map<string, Map<string, ImageSource>>();
+function key(dir: string) { const path = resolve(dir); return process.platform === 'win32' ? path.toLowerCase() : path; }
+/** Register while the owning World is started; dispose on stop. log:/mem: remain host-owned. */
+export function registerImageSource(dir: string, scheme: string, source: ImageSource): () => void {
+  if (!/^[a-z][a-z0-9-]*$/.test(scheme) || ['log', 'mem'].includes(scheme)) throw new Error('Invalid image source scheme');
+  const scope = key(dir);
+  let entries = sources.get(scope);
+  if (!entries) sources.set(scope, entries = new Map());
+  if (entries.has(scheme)) throw new Error(`Image source already registered: ${scheme}`);
+  entries.set(scheme, source);
+  return () => {
+    if (entries.get(scheme) === source) entries.delete(scheme);
+    if (!entries.size && sources.get(scope) === entries) sources.delete(scope);
+  };
+}
+export async function resolveSourceImage(dir: string, reference: string): Promise<SourceImage | null> {
+  const colon = reference.indexOf(':');
+  if (colon < 1) return null;
+  const source = sources.get(key(dir))?.get(reference.slice(0, colon));
+  return source ? source(reference.slice(colon + 1)) : null;
+}
