diff --git a/tests/worlds/image-sources.test.ts b/tests/worlds/image-sources.test.ts
new file mode 100644
index 0000000..bef3a30
--- /dev/null
+++ b/tests/worlds/image-sources.test.ts
@@ -0,0 +1,29 @@
+import { expect, it } from 'vitest';
+import { mkdtemp, readFile, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { registerImageSource, resolveSourceImage } from '../../src/worlds/image-sources.ts';
+
+it('isolates image sources by deployment, preserves exact ids, and unregisters on disposal', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'image-source-'));
+  const bytes = Buffer.from('89504e470d0a1a0a', 'hex');
+  const file = join(dir, 'image.png'); await writeFile(file, bytes);
+  const source = async (id: string) => {
+    if (id !== 'pack:image') throw new Error('Unknown image');
+    return { bytes: await readFile(file), mime: 'image/png' };
+  };
+  const dispose = registerImageSource(dir, 'fixture', source);
+  try {
+    expect(await resolveSourceImage(dir, 'fixture:pack:image')).toEqual({ bytes, mime: 'image/png' });
+    expect(await resolveSourceImage(join(dir, 'other'), 'fixture:pack:image')).toBeNull();
+    await expect(resolveSourceImage(dir, 'fixture:pack:image.extra')).rejects.toThrow('Unknown image');
+    expect(() => registerImageSource(dir, 'fixture', source)).toThrow('already registered');
+    expect(() => registerImageSource(dir, 'log', source)).toThrow('Invalid');
+    dispose();
+    expect(await resolveSourceImage(dir, 'fixture:pack:image')).toBeNull();
+    const next = registerImageSource(dir, 'fixture', source);
+    dispose();
+    expect(await resolveSourceImage(dir, 'fixture:pack:image')).not.toBeNull();
+    next();
+  } finally { dispose(); await rm(dir, { recursive: true, force: true }); }
+});
