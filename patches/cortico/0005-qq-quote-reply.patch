diff --git a/tests/integration/qq-quote-reply.test.ts b/tests/integration/qq-quote-reply.test.ts
new file mode 100644
index 0000000..b1c74f9
--- /dev/null
+++ b/tests/integration/qq-quote-reply.test.ts
@@ -0,0 +1,59 @@
+import { expect, it } from 'vitest';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { assembleBot } from '../../bots/corti-soulmate/assemble.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import { LANGUAGES } from '../../src/core/language.ts';
+import { qqConfigGroup, QQ_DEFAULTS } from '../../src/worlds/qq/config.ts';
+import { MockOneBot } from '../helpers/mock-onebot.ts';
+import { FakeLLM, makeCfg, makeLoaded, makeTmpDir, sleep } from '../core/helpers.ts';
+
+it.each(['group', 'private'] as const)('%s replies omit quotes by default and honor changes at send time', async kind => {
+  const tmp = makeTmpDir();
+  const mock = new MockOneBot({ port: 0, groupId: 424242 });
+  const port = await mock.start();
+  const cfg = makeCfg();
+  cfg.worlds.qq = { ...cfg.worlds.qq, enabled: true, wsUrl: `ws://127.0.0.1:${port}`,
+    groups: [{ id: 424242, enabled: true }], privates: [{ id: 1001, enabled: true }] };
+  cfg.worlds.console.enabled = false; cfg.web.port = 0;
+  cfg.tick.dayIntervalMinutes = [999, 999]; cfg.tick.nightIntervalMinutes = null;
+  const memoryDir = join(tmp.dir, 'memory'); mkdirSync(memoryDir, { recursive: true });
+  writeFileSync(join(memoryDir, 'CONSTITUTION.md'), 'Fixture persona');
+  const bot = assembleBot(makeLoaded({ config: cfg, rootDir: tmp.dir, memoryDir, dataDir: join(tmp.dir, 'data') }), { llm: new FakeLLM() });
+  bot.core.bus.setPaused(true);
+  try {
+    await bot.start(); await bot.qqWorld!.waitReady(5000);
+    expect(cfg.worlds.qq.quoteReply).toBe(QQ_DEFAULTS.quoteReply);
+    expect(cfg.worlds.qq.quoteReply).toBe(false);
+    const message = { user_id: 1001, nickname: 'fixture', text: 'hello' };
+    const mid = kind === 'group' ? mock.emitGroupMessage(message) : mock.emitPrivateMessage(message);
+    const deadline = Date.now() + 5000;
+    while (!bot.core.store.range({}).some(e => e.meta?.message_id === mid) && Date.now() < deadline) await sleep(20);
+    expect(bot.core.store.range({}).some(e => e.type === 'qq.message' && e.meta?.message_id === mid)).toBe(true);
+    const tool = (name: string) => bot.qqWorld!.tools().find(t => t.name === name)!;
+    const ctx = { role: 'main', log: nullLogger() };
+    const draft = () => tool('qq_draft').handler({ text: 'reply', reply_to: String(mid) }, ctx);
+    const send = () => tool('qq_confirm').handler({ decision: 'send' }, ctx);
+    expect(await draft()).toContain('without quoting');
+    expect(await send()).toContain('sent without quoting');
+    expect(mock.outbox[0]).toMatchObject({ action: `send_${kind}_msg`, params: { message: [{ type: 'text', data: { text: 'reply' } }] } });
+    cfg.worlds.qq.quoteReply = true;
+    expect(await draft()).toContain(`Will quote #${mid}`);
+    await send();
+    expect(mock.outbox[1].params.message).toEqual([{ type: 'reply', data: { id: String(mid) } }, { type: 'text', data: { text: 'reply' } }]);
+    await draft(); cfg.worlds.qq.quoteReply = false;
+    expect(await send()).toContain('sent without quoting');
+    expect(mock.outbox[2].params.message).toEqual([{ type: 'text', data: { text: 'reply' } }]);
+    expect(bot.core.store.range({}).filter(e => e.type === 'qq.self')).toHaveLength(3);
+  } finally { await bot.stop(); await mock.close(); tmp.cleanup(); }
+}, 15000);
+
+it('declares the hot quote setting in every supported UI language', () => {
+  const titles = LANGUAGES.map(language => {
+    const field = qqConfigGroup(language).schema.properties!['worlds.qq.quoteReply'];
+    expect(field).toMatchObject({ type: 'boolean', 'x-hot': true });
+    expect(field.description).toBeTruthy();
+    return field.title;
+  });
+  expect(new Set(titles).size).toBe(LANGUAGES.length);
+});
