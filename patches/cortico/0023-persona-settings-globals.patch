--- /dev/null
+++ b/src/core/globals.ts
@@ -0,0 +1,44 @@
+/**
+ * 全局变量：部署级、所有 World 都能读的设置，在设置页「全局变量」或 Persona 页的「配置」编辑，立即生效。
+ * 现在只有可信 QQ 白名单；它本身不授予任何权限，用不用、怎么用由各插件决定（比如存图、委派）。
+ */
+import type { ConfigGroup } from './config-schema.ts';
+import type { Language } from './language.ts';
+
+export interface GlobalsConfig {
+  /** 可信 QQ 号，逗号或空白分隔。 */
+  trustedQQ: string;
+}
+export const GLOBALS_DEFAULTS: GlobalsConfig = { trustedQQ: '' };
+
+/** 插件读到的解析结果。 */
+export interface Globals {
+  /** 去重后的 QQ 号，保持填写顺序；不是 5–12 位数字的项被丢掉。 */
+  trustedQQ: readonly string[];
+}
+
+export function readGlobals(config: { globals?: Partial<GlobalsConfig> }): Globals {
+  const raw = typeof config.globals?.trustedQQ === 'string' ? config.globals.trustedQQ : '';
+  return { trustedQQ: [...new Set(raw.split(/[\s,，、;；]+/).filter((s) => /^\d{5,12}$/.test(s)))] };
+}
+
+const strings: Record<Language, readonly [string, string, string]> = {
+  zh: ['全局变量', '白名单 QQ', '所有插件共用的可信 QQ 号，多个用逗号分隔。它本身不授予权限，由各插件决定怎么用（比如谁能让她存图、委派任务），改完立即生效。'],
+  'zh-Hant': ['全域變數', '白名單 QQ', '所有外掛共用的可信 QQ 號，多個用逗號分隔。它本身不授予權限，由各外掛決定怎麼用（例如誰能讓她存圖、委派任務），修改後立即生效。'],
+  en: ['Global variables', 'Trusted QQ numbers', 'Trusted QQ numbers shared by every plugin, comma separated. They grant nothing by themselves; each plugin decides how to use them (for example who may have pictures saved or tasks delegated). Changes apply immediately.'],
+  ja: ['グローバル変数', '信頼する QQ 番号', 'すべてのプラグインが共有する信頼済み QQ 番号。複数はカンマ区切り。これ自体は権限を与えず、使い方は各プラグインが決めます（画像の保存や委任を誰に許すかなど）。変更はすぐに反映されます。'],
+  ko: ['전역 변수', '신뢰하는 QQ 번호', '모든 플러그인이 공유하는 신뢰 QQ 번호이며 쉼표로 구분합니다. 그 자체로는 권한을 주지 않으며, 사용 방식은 각 플러그인이 정합니다(예: 누가 이미지 저장이나 작업 위임을 시킬 수 있는지). 변경은 즉시 적용됩니다.'],
+  fr: ['Variables globales', 'Numéros QQ de confiance', 'Numéros QQ de confiance partagés par toutes les extensions, séparés par des virgules. Ils n’accordent rien par eux-mêmes ; chaque extension décide comment les utiliser (par exemple qui peut faire enregistrer des images ou déléguer des tâches). Effet immédiat.'],
+  de: ['Globale Variablen', 'Vertrauenswürdige QQ-Nummern', 'Vertrauenswürdige QQ-Nummern für alle Erweiterungen, durch Kommas getrennt. Sie gewähren selbst keine Rechte; jede Erweiterung entscheidet, wie sie sie nutzt (etwa wer Bilder speichern oder Aufgaben delegieren lassen darf). Änderungen gelten sofort.'],
+  'es-419': ['Variables globales', 'Números QQ de confianza', 'Números QQ de confianza compartidos por todas las extensiones, separados por comas. No otorgan permisos por sí solos; cada extensión decide cómo usarlos (por ejemplo, quién puede pedir guardar imágenes o delegar tareas). Los cambios se aplican de inmediato.'],
+  'pt-BR': ['Variáveis globais', 'Números QQ confiáveis', 'Números QQ confiáveis compartilhados por todas as extensões, separados por vírgulas. Não concedem nada sozinhos; cada extensão decide como usá-los (por exemplo, quem pode pedir para salvar imagens ou delegar tarefas). As alterações valem na hora.'],
+  it: ['Variabili globali', 'Numeri QQ fidati', 'Numeri QQ fidati condivisi da tutte le estensioni, separati da virgole. Da soli non concedono permessi; ogni estensione decide come usarli (per esempio chi può far salvare immagini o delegare compiti). Le modifiche valgono subito.'],
+  ru: ['Глобальные переменные', 'Доверенные номера QQ', 'Доверенные номера QQ, общие для всех расширений, через запятую. Сами по себе ничего не разрешают; каждое расширение решает, как их использовать (например, кто может просить сохранить изображения или поручить задачу). Изменения действуют сразу.'],
+};
+
+export function globalsConfigGroup(language: Language): ConfigGroup {
+  const [title, trusted, description] = strings[language];
+  return { id: 'globals', owner: 'persona', schema: { type: 'object', title, description, properties: {
+    'globals.trustedQQ': { type: 'string', title: trusted, 'x-hot': true },
+  } } };
+}
