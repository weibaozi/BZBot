diff --git a/tests/web/settings-persona.test.ts b/tests/web/settings-persona.test.ts
new file mode 100644
index 0000000..95a23ff
--- /dev/null
+++ b/tests/web/settings-persona.test.ts
@@ -0,0 +1,77 @@
+/** @vitest-environment jsdom */
+/** The Settings page gives each persona-owned config group its own menu item, before 外观. */
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { createWebUi } from '../../src/web/client/ui/index.ts';
+import { Lifecycle } from '../../src/web/client/core/lifecycle.ts';
+import { Router } from '../../src/web/client/core/router.ts';
+import type { FeatureContext } from '../../src/web/client/features/feature.ts';
+
+const config = {
+  groups: [
+    { group: { id: 'core', owner: 'core', schema: { title: '主循环', properties: { 'loop.idleMs': { type: 'integer', title: '空转间隔' } } } }, values: { 'loop.idleMs': 1 } },
+    { group: { id: 'model-timeouts', owner: 'persona', schema: { title: '模型请求超时', properties: { 'modelTimeouts.totalSec': { type: 'integer', title: '整轮时限' } } } }, values: { 'modelTimeouts.totalSec': 120 } },
+    { group: { id: 'globals', owner: 'persona', schema: { title: '全局变量', properties: { 'globals.trustedQQ': { type: 'string', title: '白名单 QQ' } } } }, values: { 'globals.trustedQQ': '361270936' } },
+    { group: { id: 'corti-soulmate', owner: 'persona', schema: { title: '认知节奏', properties: { 'tick.dayIntervalMinutes': { type: 'integer', title: '白天间隔' } } } }, values: { 'tick.dayIntervalMinutes': 30 } },
+    { group: { id: 'world:qq', owner: 'world:qq', schema: { title: 'QQ 连接', properties: { 'worlds.qq.wsUrl': { type: 'string', title: '地址' } } } }, values: { 'worlds.qq.wsUrl': 'ws://x' } },
+  ],
+};
+
+let lifecycle: Lifecycle;
+beforeEach(() => {
+  vi.resetModules();
+  document.documentElement.lang = 'zh-CN';
+  document.body.replaceChildren();
+  lifecycle = new Lifecycle(() => {});
+  vi.stubGlobal('fetch', async (url: unknown) => {
+    if (String(url).startsWith('/api/config')) return new Response(JSON.stringify(config), { headers: { 'Content-Type': 'application/json' } });
+    return new Response('{}', { status: 404 });
+  });
+});
+afterEach(() => { lifecycle.dispose(); vi.unstubAllGlobals(); });
+
+function context(capabilities: Record<string, boolean>): FeatureContext {
+  const root = document.createElement('div');
+  document.body.append(root);
+  const ui = createWebUi({ memo: { get: (_key, fallback) => fallback, set: () => {} }, overlayHost: document.body, signal: lifecycle.signal, doc: document });
+  return {
+    root, ui, lifecycle, signal: lifecycle.signal, capabilities,
+    route: { segments: ['settings'], query: {}, raw: '/settings' },
+    router: new Router({ win: window, confirmLeave: async () => true }),
+    onError: (err) => { throw err; },
+  };
+}
+
+const tabs = (root: HTMLElement) => [...root.querySelectorAll('[role="tab"]')].map((tab) => tab.textContent);
+
+it('shows one config group per section and nothing else', async () => {
+  const { mountConfigGroup } = await import('../../src/web/client/features/settings/persona.ts');
+  const ctx = context({ config: true });
+  await mountConfigGroup(ctx, 'globals');
+  const text = ctx.root.textContent!;
+  expect(text).toContain('白名单 QQ');
+  expect(text).not.toContain('整轮时限');
+  expect(text).not.toContain('QQ 连接');
+});
+
+it('lists each persona group as its own menu item between 通用 and 外观, only where config is mounted', async () => {
+  const { mountSettings } = await import('../../src/web/client/features/settings/index.ts');
+  const withConfig = context({ config: true });
+  mountSettings(withConfig);
+  await vi.waitFor(() => expect(tabs(withConfig.root)).toEqual(['通用', '模型请求超时', '全局变量', '认知节奏', '外观']));
+  // 选中的仍是第一栏,点哪一栏就切到哪一栏。
+  expect(withConfig.root.querySelector('[aria-selected="true"]')?.textContent).toBe('通用');
+  (withConfig.root.querySelectorAll('[role="tab"]')[2] as HTMLButtonElement).click();
+  expect(withConfig.root.querySelector('.settings-section.active')?.id).toBe('settings-persona-globals');
+
+  const without = context({});
+  mountSettings(without);
+  await new Promise((resolve) => setTimeout(resolve, 20));
+  expect(tabs(without.root)).toEqual(['通用', '外观']);
+});
+
+it('puts 设置 in the Core group of the sidebar', async () => {
+  const { settingsFeature } = await import('../../src/web/client/features/settings/index.ts');
+  const { S: CORE } = await import('../../src/web/client/features/core/strings.ts');
+  expect(settingsFeature).toMatchObject({ route: 'settings', navGroup: CORE.navGroup });
+  expect('navMode' in settingsFeature).toBe(false);
+});
