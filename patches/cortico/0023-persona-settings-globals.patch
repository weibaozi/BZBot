diff --git a/tests/globals.test.ts b/tests/globals.test.ts
new file mode 100644
index 0000000..014b514
--- /dev/null
+++ b/tests/globals.test.ts
@@ -0,0 +1,46 @@
+/** Global variables: one deployment-wide trusted QQ list every World reads live. */
+import { afterEach, expect, it } from 'vitest';
+import { loadDeployment } from '../src/deploy.ts';
+import { GLOBALS_DEFAULTS, globalsConfigGroup, readGlobals } from '../src/core/globals.ts';
+import { LANGUAGES } from '../src/core/language.ts';
+import { NO_MODELS } from '../src/providers/model-hub.ts';
+import { WorldAssembly, type WorldContext, type WorldDefinition } from '../src/world.ts';
+import { makeCfg, makeTmpDir } from './core/helpers.ts';
+
+const cleanups: Array<() => void> = [];
+afterEach(() => cleanups.splice(0).forEach(fn => fn()));
+
+it('parses the trusted QQ list, dropping duplicates and anything that is not a QQ number', () => {
+  expect(readGlobals({})).toEqual({ trustedQQ: [] });
+  expect(readGlobals({ globals: GLOBALS_DEFAULTS })).toEqual({ trustedQQ: [] });
+  expect(readGlobals({ globals: { trustedQQ: '361270936, 12345，361270936 abc 1234 9999999999999;779070626' } }))
+    .toEqual({ trustedQQ: ['361270936', '12345', '779070626'] });
+});
+
+it('declares a hot persona-owned group in every language', () => {
+  const titles = new Set<string>();
+  for (const language of LANGUAGES) {
+    const group = globalsConfigGroup(language);
+    expect(group).toMatchObject({ id: 'globals', owner: 'persona' });
+    expect(group.schema.properties['globals.trustedQQ']).toMatchObject({ type: 'string', 'x-hot': true });
+    titles.add(`${language}:${group.schema.title}`);
+    expect(group.schema.description?.length).toBeGreaterThan(20);
+  }
+  expect(titles.size).toBe(LANGUAGES.length);
+});
+
+it('gives every World the live list through its context', async () => {
+  const temp = makeTmpDir(); cleanups.push(temp.cleanup);
+  let ctx: WorldContext | undefined;
+  const def: WorldDefinition = {
+    id: 'reader', label: 'reader', defaults: () => ({ enabled: true }),
+    create: (c) => { ctx = c; return { id: 'reader', tools: () => [], envPromptVars: () => null, start: async () => {}, stop: async () => {} }; },
+  };
+  const loaded = loadDeployment({ defaults: () => makeCfg() }, temp.dir, temp.dir);
+  const assembly = new WorldAssembly(loaded, [def], [], NO_MODELS);
+  assembly.bind({ mount: async (mod) => { assembly.mounted.push(mod); }, unmount: async () => {} });
+  expect(ctx!.globals?.()).toEqual({ trustedQQ: [] });
+  // The settings page writes into the live config object; the next read sees it without a restart.
+  loaded.config.globals = { trustedQQ: '361270936' };
+  expect(ctx!.globals?.()).toEqual({ trustedQQ: ['361270936'] });
+});
