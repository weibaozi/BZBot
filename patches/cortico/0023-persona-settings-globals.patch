diff --git a/src/web/client/features/settings/persona.ts b/src/web/client/features/settings/persona.ts
new file mode 100644
index 0000000..c1322b0
--- /dev/null
+++ b/src/web/client/features/settings/persona.ts
@@ -0,0 +1,21 @@
+import { createConfigView } from '../config/view.ts';
+import type { FeatureContext } from '../feature.ts';
+import { S } from './strings.ts';
+
+/**
+ * 「人格」一栏：归 Persona 的配置组（模型请求超时、全局变量和 Persona 自己声明的组）集中在设置页，
+ * Persona 页只留运维操作。保存与校验走通用配置视图，和原来 Persona 页的配置页签一样。
+ */
+export async function mountPersonaSettings(ctx: FeatureContext): Promise<void> {
+  const view = createConfigView({
+    ui: ctx.ui,
+    lifecycle: ctx.lifecycle,
+    signal: ctx.signal,
+    filter: (group) => group.owner === 'persona',
+    showOwner: false,
+    groupTabs: true,
+    emptyText: S.personaEmpty,
+  });
+  ctx.root.append(view.el);
+  await view.load();
+}
