@@ -0,0 +1,21 @@
+import { createConfigView } from '../config/view.ts';
+import type { FeatureContext } from '../feature.ts';
+import { S } from './strings.ts';
+
+/**
+ * 设置页里 Persona 认领的一个配置组(模型请求超时、全局变量或 Persona 自己声明的组),一组一栏。
+ * 保存与校验走通用配置视图;Persona 页的「配置」页签里同样能改这几组。
+ */
+export async function mountConfigGroup(ctx: FeatureContext, groupId: string): Promise<void> {
+  const view = createConfigView({
+    ui: ctx.ui,
+    lifecycle: ctx.lifecycle,
+    signal: ctx.signal,
+    filter: (group) => group.id === groupId,
+    showOwner: false,
+    groupTabs: false,
+    emptyText: S.personaEmpty,
+  });
+  ctx.root.append(view.el);
+  await view.load();
+}
