+  for (const [name, config] of [['old', legacy], ['deepseek', source], ['.transaction-x', legacy]] as const) {
+    mkdirSync(join(root, name), { recursive: true });
+    writeFileSync(join(root, name, 'config.json'), JSON.stringify(config));
+  }
+  writeFileSync(join(root, 'deepseek', '.env'), 'CORTICO_KEY_DEEPSEEK=key\n');
+  return root;
+}
+const onDisk = (root: string) => JSON.parse(readFileSync(join(root, 'deepseek', 'config.json'), 'utf8'));
+
+it('lists legacy endpoints by directory and enabled chat models by reference', () => {
+  const table = readProviders(fixture());
+  expect(Object.keys(table).sort()).toEqual(['deepseek/flash', 'deepseek/org/gpt-6.1', 'deepseek/pro', 'old']);
+  expect(table.old).toEqual(legacy);
+  expect(table['deepseek/flash']).toEqual({
+    kind: 'openai-responses-compat', baseUrl: 'https://source.test', secret: 'CORTICO_KEY_DEEPSEEK', options: { reasoningReplay: 'plaintext' },
+    spec: { model: 'flash', thinking: true, temperature: 0.65 }, multimodal: true,
+  });
+  expect(table['deepseek/pro'].spec?.model).toBe('pro');
+});
+
+it('maps a directory name onto its only enabled chat model and leaves other names alone', () => {
+  const table = readProviders(fixture());
+  expect(canonicalName('old', table)).toBe('old');
+  expect(canonicalName('deepseek', table)).toBe('deepseek');
+  expect(canonicalName('deepseek', { 'deepseek/flash': table['deepseek/flash'] })).toBe('deepseek/flash');
+  expect(canonicalName('missing', table)).toBe('missing');
+});
+
+it('writes shared fields to the source and model fields to that model only', () => {
+  const root = fixture();
+  const current = readProviders(root)['deepseek/flash'];
+  const next = writeEntry(root, 'deepseek/flash', { ...current, baseUrl: 'https://moved.test', spec: { ...current.spec!, temperature: 1 } });
+  const saved = onDisk(root);
+  expect(saved.baseUrl).toBe('https://moved.test');
+  expect(saved.models.flash).toEqual({ type: 'chat', spec: { model: 'flash', thinking: true, temperature: 1 }, multimodal: true });
+  expect(saved.models['bge-m3']).toEqual({ type: 'embedding' });
+  expect(saved.models.off.enabled).toBe(false);
+  expect(next['deepseek/pro'].baseUrl).toBe('https://moved.test');
+  expect(() => writeEntry(root, 'deepseek/flash', { ...current, spec: { ...current.spec!, model: 'other' } })).toThrow('spec.model');
+  expect(() => writeEntry(root, 'absent/flash', current)).toThrow('absent');
