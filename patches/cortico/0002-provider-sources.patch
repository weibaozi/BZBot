diff --git a/src/providers/store.ts b/src/providers/store.ts
new file mode 100644
index 0000000..0e1b218
--- /dev/null
+++ b/src/providers/store.ts
@@ -0,0 +1,152 @@
+/**
+ * `<部署根>/providers/` 的读写。一个目录有两种格式:
+ * - 旧格式:目录即端点,`config.json` 是一条 `LLMProviderEntry`,端点名 = 目录名。
+ * - 供应商格式:`config.json` 带 `models`,地址、协议、密钥与模块选项归供应商,模型各带类型与生成参数。
+ *   启用的对话模型展开成端点,名字是模型引用 `<供应商>/<模型 id>`。
+ * Core 只看展开后的端点表;目录、密钥与 provider 状态按名字的供应商段定位,同一供应商的模型共用。
+ */
+import { existsSync, mkdirSync, readdirSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+import type { LLMProviderEntry, ModelSpec } from '../core/types.ts';
+import type { PriceDefinition } from './pricebook.ts';
+import { readTextFile } from '../core/util.ts';
+import { updateJsonObject } from '../config-file.ts';
+import { modelOf, modelRef, sourceOf } from './name.ts';
+
+export type ModelType = 'chat' | 'embedding' | 'rerank' | 'stt' | 'tts';
+
+/** 供应商下的一个模型。`type` 缺省为对话,`enabled` 缺省为启用。 */
+export interface SourceModel {
+  type?: ModelType;
+  enabled?: boolean;
+  spec?: ModelSpec;
+  pricing?: PriceDefinition[];
+  multimodal?: boolean;
+  serviceTier?: string;
+}
+
+/** 供应商格式的 `config.json`。`models` 的键是模型 id,也是模型引用的第二段。 */
+export interface ProviderSource extends Omit<LLMProviderEntry, 'spec' | 'pricing' | 'multimodal' | 'serviceTier'> {
+  models: Record<string, SourceModel>;
+}
+
+/** 属于模型的端点字段;其余字段归供应商,同一供应商的模型共用。 */
+const MODEL_FIELDS = ['spec', 'pricing', 'multimodal', 'serviceTier'] as const;
+
+export function isProviderSource(raw: unknown): raw is ProviderSource {
+  const models = (raw as { models?: unknown } | null)?.models;
+  return !!models && typeof models === 'object' && !Array.isArray(models);
+}
+
+/** 供应商的启用对话模型展开成端点;`spec.model` 缺省取模型 id。 */
+export function flattenSource(source: string, file: ProviderSource): Record<string, LLMProviderEntry> {
+  const { models, ...shared } = file;
+  const table: Record<string, LLMProviderEntry> = {};
+  for (const [id, model] of Object.entries(models)) {
+    if ((model.type ?? 'chat') !== 'chat' || model.enabled === false) continue;
+    const { type: _type, enabled: _enabled, ...fields } = structuredClone(model);
+    if (fields.spec && !fields.spec.model) fields.spec.model = id;
+    table[modelRef(source, id)] = { ...structuredClone(shared), ...fields };
+  }
+  return table;
+}
+
+/** 以 `.` 开头的目录是写锁、事务暂存与待删目录,不是供应商。 */
+function sourceDirs(root: string): string[] {
+  if (!existsSync(root)) return [];
+  return readdirSync(root, { withFileTypes: true })
+    .filter((dir) => dir.isDirectory() && !dir.name.startsWith('.') && existsSync(join(root, dir.name, 'config.json')))
+    .map((dir) => dir.name);
+}
+
+function readConfig(root: string, source: string): unknown {
+  const file = join(root, source, 'config.json');
+  try {
+    return JSON.parse(readTextFile(file));
+  } catch (err) {
+    throw new Error(`${file} 解析失败:${err instanceof Error ? err.message : String(err)}`);
+  }
+}
+
+/** 读出整个目录展开后的端点表。 */
+export function readProviders(root: string): Record<string, LLMProviderEntry> {
+  const table: Record<string, LLMProviderEntry> = Object.create(null);
+  for (const source of sourceDirs(root)) {
+    const raw = readConfig(root, source);
+    Object.assign(table, isProviderSource(raw) ? flattenSource(source, raw) : { [source]: raw as LLMProviderEntry });
+  }
+  return table;
+}
+
+/** 名字所在的目录:旧格式是端点目录,模型引用是供应商目录。 */
+export function entryDir(root: string, name: string): string {
+  return join(root, sourceOf(name));
+}
+
+/**
+ * 把 `activeProvider` 一类的存量名字换成端点表里的名字:目录改成供应商格式后,旧的目录名
+ * 指向其中唯一的启用对话模型;对不上的原样返回,由使用方报不存在。
+ */
+export function canonicalName(name: string, table: Readonly<Record<string, LLMProviderEntry>>): string {
+  if (!name || table[name] || name.includes('/')) return name;
+  const refs = Object.keys(table).filter((key) => sourceOf(key) === name && key !== name);
+  return refs.length === 1 ? refs[0] : name;
+}
+
+/** 端点表里属于 `source` 的条目换成 `next`。 */
+export function replaceSource(
+  table: Readonly<Record<string, LLMProviderEntry>>,
+  source: string,
+  next: Readonly<Record<string, LLMProviderEntry>>,
+): Record<string, LLMProviderEntry> {
+  const kept = Object.entries(table).filter(([name]) => sourceOf(name) !== source);
+  return Object.assign(Object.create(null), Object.fromEntries(kept), next);
+}
+
+/**
+ * 写一条端点。旧格式整份替换端点目录的 `config.json`;模型引用改供应商的共用字段与这个模型的字段,
+ * 同一供应商的其他模型及非对话模型保留。返回这个目录写后展开的端点表。
+ * 模型引用要求供应商已存在,且 `spec.model` 等于模型 id。
+ */
+export function writeEntry(root: string, name: string, entry: LLMProviderEntry): Record<string, LLMProviderEntry> {
+  const source = sourceOf(name);
+  const model = modelOf(name);
+  const file = join(root, source, 'config.json');
+  if (model === null) {
+    mkdirSync(join(root, source), { recursive: true });
+    updateJsonObject(file, (raw) => {
+      for (const key of Object.keys(raw)) delete raw[key];
+      Object.assign(raw, structuredClone(entry));
+    });
+    return { [name]: structuredClone(entry) };
+  }
+  if (entry.spec && entry.spec.model !== model) throw new Error(`模型引用 ${name} 的 spec.model 必须是 ${model}`);
+  const current = existsSync(file) ? readConfig(root, source) : null;
+  if (!isProviderSource(current)) throw new Error(`供应商 ${source} 不存在`);
+  updateJsonObject(file, (raw) => {
+    const models = raw.models as Record<string, SourceModel>;
+    for (const key of Object.keys(raw)) if (key !== 'models') delete raw[key];
+    const next: Record<string, unknown> = { ...models[model] };
+    for (const field of MODEL_FIELDS) delete next[field];
+    for (const [key, value] of Object.entries(structuredClone(entry))) {
+      if ((MODEL_FIELDS as readonly string[]).includes(key)) next[key] = value;
+      else raw[key] = value;
+    }
+    models[model] = next as SourceModel;
+  });
+  return flattenSource(source, readConfig(root, source) as ProviderSource);
+}
+
+/** 删一条端点:旧格式删整个端点目录;模型引用只删这个模型,供应商与它的密钥保留。返回写后展开的端点表。 */
+export function removeEntry(root: string, name: string): Record<string, LLMProviderEntry> {
+  const source = sourceOf(name);
+  const model = modelOf(name);
+  if (model === null) {
+    rmSync(join(root, source), { recursive: true, force: true });
+    return {};
+  }
+  updateJsonObject(join(root, source, 'config.json'), (raw) => {
+    delete (raw.models as Record<string, SourceModel>)[model];
+  });
+  return flattenSource(source, readConfig(root, source) as ProviderSource);
+}
