+  const next = removeEntry(root, 'deepseek/flash');
+  expect(Object.keys(next).sort()).toEqual(['deepseek/org/gpt-6.1', 'deepseek/pro']);
+  expect(onDisk(root).models.flash).toBeUndefined();
