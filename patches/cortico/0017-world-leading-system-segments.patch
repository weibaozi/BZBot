+++ b/tests/core/leading-prefix.test.ts
@@ -0,0 +1,23 @@
+import { expect, it } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { CortiSoulmate } from '../../bots/corti-soulmate/persona/index.ts';
+import { makeCfg } from './helpers.ts';
+import { assembleSystem } from '../../src/core/prefix.ts';
+import type { World } from '../../src/core/types.ts';
+
+it('orders leading segments by World id, preserves each World order and propagates failures', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'leading-prefix-'));
+  try {
+    const persona = new CortiSoulmate({ cfg: makeCfg(), memoryDir: dir });
+    const world = (id: string, text: string): World => ({ id, envPromptVars: () => null, tools: () => [],
+      start: async () => {}, stop: async () => {}, leadingSystemSegments: () => [{ title: id, text }] });
+    const deps = { persona, now: new Date(), timezone: 'UTC' };
+    const base = await assembleSystem({ ...deps, worlds: [] });
+    expect(await assembleSystem({ ...deps, worlds: [world('z', 'Z'), world('a', 'A')] })).toBe('AZ' + base);
+    const broken = world('broken', '');
+    broken.leadingSystemSegments = () => { throw new Error('unreadable rules'); };
+    await expect(assembleSystem({ ...deps, worlds: [broken] })).rejects.toThrow('unreadable rules');
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
