 /** 供 WebUI 观察:前缀的分段视图(与实际发出的前缀同一来源) */
 export async function assembleSystemSegments(deps: AssembleSystemDeps): Promise<PrefixSegment[]> {
   const { persona, worlds, now, timezone, dirs } = deps;
-  return persona.systemSegments({
+  const leading = await Promise.all([...worlds].sort((a, b) => a.id.localeCompare(b.id))
+    .map(async (world) => ({ after: world.leadingSystemSegmentsAfter, segments: await world.leadingSystemSegments?.() ?? [] })));
+  const segments = await persona.systemSegments({
     now,
     timezone,
     worlds: await collectWorldContexts(worlds, dirs),
   });
+  const result = [...segments];
+  for (const block of leading.reverse()) {
+    if (!block.segments.length) continue;
+    const anchors = block.after === undefined ? [] : segments.filter(segment => segment.sourceKey === block.after);
+    if (block.after !== undefined && anchors.length !== 1) throw new Error(`System segment anchor must match exactly once: ${block.after}`);
+    const at = block.after === undefined ? 0 : result.indexOf(anchors[0]) + 1;
+    result.splice(at, 0, ...block.segments);
+  }
+  return result;
 }
 
