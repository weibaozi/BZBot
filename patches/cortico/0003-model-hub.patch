diff --git a/src/providers/model-hub.ts b/src/providers/model-hub.ts
new file mode 100644
index 0000000..6fb284c
--- /dev/null
+++ b/src/providers/model-hub.ts
@@ -0,0 +1,70 @@
+/**
+ * 模型中心的接口,给 World 与 bot 包用;实现见 models.ts。
+ * 这里不加载 provider 模块,装配层可以只拿接口与 `NO_MODELS`。
+ */
+import type { LLMUsage, ModelSpec } from '../core/types.ts';
+import type { Charge, Generation } from '../core/generation.ts';
+import type { ContextRecord } from '../protocol/open-responses/context.ts';
+import { usageCounters } from '../protocol/open-responses/context-helpers.ts';
+import type { ModelType } from './store.ts';
+
+/** 可选用的模型。`multimodal` 是对话模型接受图片输入的开关。 */
+export interface ModelInfo {
+  ref: string;
+  source: string;
+  model: string;
+  type: ModelType;
+  multimodal: boolean;
+  contextWindow?: number;
+}
+
+export interface ModelHub {
+  /** 启用且协议模块支持其类型的模型;`image` 只留接受图片输入的对话模型。 */
+  list(type?: ModelType, filter?: { image?: boolean }): ModelInfo[];
+  /** 一次对话生成。`overrides` 只改这一次的生成参数,不改模型配置。 */
+  chat(ref: string, context: readonly ContextRecord[], options?: ChatOptions): Promise<Generation>;
+  /** 每段文本一个向量,顺序与输入一致。 */
+  embed(ref: string, texts: readonly string[], signal?: AbortSignal): Promise<number[][]>;
+  /** 按相关度从高到低,`index` 指向 `documents` 的下标。 */
+  rerank(ref: string, query: string, documents: readonly string[], signal?: AbortSignal): Promise<Array<{ index: number; score: number }>>;
+  transcribe(ref: string, audio: { bytes: Uint8Array; mime: string; name?: string }, signal?: AbortSignal): Promise<string>;
+  speak(ref: string, text: string, options?: { voice?: string; signal?: AbortSignal }): Promise<{ bytes: Uint8Array; mime: string }>;
+}
+
+export interface ChatOptions {
+  overrides?: Partial<Omit<ModelSpec, 'model'>>;
+  signal?: AbortSignal;
+  /** 记进用量与日志的调用方标签。 */
+  role?: string;
+}
+
+/** 一次对话生成按 `host.reportUsage` 的参数形状给出用量;没有计量时为 null。 */
+export function generationUsage(generation: Generation): { usage: LLMUsage; opts: { model: string; charges: Charge[] } } | null {
+  const attempt = generation.attempts.at(-1);
+  if (!attempt) return null;
+  return { usage: usageCounters(attempt.meters), opts: { model: generation.response.model, charges: attempt.charges ?? [] } };
+}
+
+/** 一次对话生成的输出文本,按输出顺序拼接。 */
+export function outputText(generation: Generation): string {
+  return generation.response.output.flatMap((item) => item.type === 'message'
+    ? item.content.flatMap((part) => part.type === 'output_text' ? [part.text] : [])
+    : []).join('');
+}
+
+/** `x-options` 的 `models:<类型>[:image]`:可选模型的引用表;不是这个前缀返回 null。 */
+export function modelOptions(hub: ModelHub, kind: string): Array<{ value: string; label: string }> | null {
+  const match = /^models:(chat|embedding|rerank|stt|tts)(:image)?$/.exec(kind);
+  if (!match) return null;
+  return hub.list(match[1] as ModelType, { image: Boolean(match[2]) }).map((m) => ({ value: m.ref, label: m.ref }));
+}
+
+/** 没有部署根的装配(干装载、单元测试)用的模型中心:没有模型,调用即报错。 */
+export const NO_MODELS: ModelHub = {
+  list: () => [],
+  chat: async (ref) => { throw new Error(`没有这个模型: ${ref}`); },
+  embed: async (ref) => { throw new Error(`没有这个模型: ${ref}`); },
+  rerank: async (ref) => { throw new Error(`没有这个模型: ${ref}`); },
+  transcribe: async (ref) => { throw new Error(`没有这个模型: ${ref}`); },
+  speak: async (ref) => { throw new Error(`没有这个模型: ${ref}`); },
+};
diff --git a/src/providers/models.ts b/src/providers/models.ts
new file mode 100644
index 0000000..bf3a464
--- /dev/null
+++ b/src/providers/models.ts
@@ -0,0 +1,117 @@
+/**
+ * 模型中心:列出 `providers/` 下的全部模型,按模型引用调用。
+ * 对话模型经端点表与 registry 的 `bind()`,与主对话同一条路,计价与来源信息照常附上;
+ * 嵌入、重排序、语音转写与合成按 OpenAI 兼容路径直连供应商的 `baseUrl`。
+ * 密钥只在这里读,调用方拿不到。用量由调用方经自己的宿主上报(World 用 `host.reportUsage`,见 model-hub.ts 的 `generationUsage`)。
+ */
+import { join } from 'node:path';
+import type { ModelSpec } from '../core/types.ts';
+import type { GenerateOptions, Generation } from '../core/generation.ts';
+import { secretReader } from '../core/secrets.ts';
+import type { ContextRecord } from '../protocol/open-responses/context.ts';
+import { responseRequest } from '../protocol/open-responses/context-helpers.ts';
+import type { ProviderModule } from './base.ts';
+import { providerModules, type ProviderRegistry } from './registry.ts';
+import { readModels, type ModelType, type StoredModel } from './store.ts';
+import type { ChatOptions, ModelHub, ModelInfo } from './model-hub.ts';
+
+export class ProviderModels implements ModelHub {
+  constructor(
+    private readonly root: string,
+    /** 惰性取得:World 在 Core 之前构造,调用发生在启动之后。 */
+    private readonly registry: () => ProviderRegistry,
+    private readonly modules: readonly ProviderModule[] = providerModules,
+    private readonly fetchImpl: typeof fetch = fetch,
+  ) {}
+
+  private supported(model: StoredModel): boolean {
+    const module = this.modules.find((m) => m.id === model.entry.kind);
+    return !!module && (module.modelTypes ?? ['chat']).includes(model.type);
+  }
+
+  private find(ref: string, type: ModelType): StoredModel {
+    const model = readModels(this.root).find((m) => m.ref === ref);
+    if (!model) throw new Error(`没有这个模型: ${ref}`);
+    if (model.type !== type) throw new Error(`模型 ${ref} 的类型是 ${model.type},不是 ${type}`);
+    if (!model.enabled) throw new Error(`模型 ${ref} 已停用`);
+    if (!this.supported(model)) throw new Error(`供应商 ${model.source} 的协议模块不支持 ${type} 模型`);
+    return model;
+  }
+
+  list(type?: ModelType, filter: { image?: boolean } = {}): ModelInfo[] {
+    return readModels(this.root)
+      .filter((m) => m.enabled && this.supported(m) && (!type || m.type === type) && (!filter.image || (m.type === 'chat' && m.entry.multimodal === true)))
+      .map((m) => ({
+        ref: m.ref, source: m.source, model: m.model, type: m.type, multimodal: m.entry.multimodal === true,
+        ...(m.entry.spec?.contextWindow !== undefined ? { contextWindow: m.entry.spec.contextWindow } : {}),
+      }));
+  }
+
+  async chat(ref: string, context: readonly ContextRecord[], options: ChatOptions = {}): Promise<Generation> {
+    const model = this.find(ref, 'chat');
+    if (!model.entry.spec) throw new Error(`模型 ${ref} 还没有配置生成参数`);
+    const spec: ModelSpec = { ...model.entry.spec, ...options.overrides, model: model.entry.spec.model };
+    const generate: GenerateOptions = { nativeSpec: spec, ...(options.signal ? { signal: options.signal } : {}), ...(options.role ? { role: options.role } : {}) };
+    return this.registry().bind(ref).respond(responseRequest(spec, context), generate);
+  }
+
+  private headers(model: StoredModel, json: boolean): Record<string, string> {
+    const key = model.entry.secret ? secretReader(join(this.root, model.source, '.env'))(model.entry.secret) : '';
+    const extra = (model.entry.options as { extraHeaders?: Record<string, string> } | undefined)?.extraHeaders ?? {};
+    return { ...(json ? { 'Content-Type': 'application/json' } : {}), ...extra, ...(key ? { Authorization: `Bearer ${key}` } : {}) };
+  }
+
+  private async post(model: StoredModel, path: string, body: string | FormData, json: boolean, signal?: AbortSignal): Promise<Response> {
+    const url = model.entry.baseUrl.replace(/\/+$/, '') + path;
+    const response = await this.fetchImpl(url, {
+      method: 'POST', headers: this.headers(model, json), body, redirect: 'error',
+      signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(REQUEST_TIMEOUT_MS)]) : AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`${model.ref} ${path} 请求失败 (HTTP ${response.status})`);
+    return response;
+  }
+
+  private modelName(model: StoredModel): string {
+    return model.entry.spec?.model || model.model;
+  }
+
+  async embed(ref: string, texts: readonly string[], signal?: AbortSignal): Promise<number[][]> {
+    const model = this.find(ref, 'embedding');
+    const response = await this.post(model, '/embeddings', JSON.stringify({ model: this.modelName(model), input: texts, encoding_format: 'float' }), true, signal);
+    const body = await response.json() as { data?: Array<{ index: number; embedding: number[] }> };
+    const data = body.data?.slice().sort((a, b) => a.index - b.index);
+    if (!data || data.length !== texts.length || data.some((d, i) => d.index !== i || !Array.isArray(d.embedding)))
+      throw new Error(`${ref} 返回的向量与输入条数不一致`);
+    return data.map((d) => d.embedding);
+  }
+
+  async rerank(ref: string, query: string, documents: readonly string[], signal?: AbortSignal): Promise<Array<{ index: number; score: number }>> {
+    const model = this.find(ref, 'rerank');
+    const response = await this.post(model, '/rerank', JSON.stringify({ model: this.modelName(model), query, documents }), true, signal);
+    const body = await response.json() as { results?: Array<{ index: number; relevance_score: number }> };
+    if (!Array.isArray(body.results) || body.results.some((r) => !Number.isInteger(r.index) || r.index < 0 || r.index >= documents.length || typeof r.relevance_score !== 'number'))
+      throw new Error(`${ref} 返回的重排序结果无效`);
+    return body.results.map((r) => ({ index: r.index, score: r.relevance_score })).sort((a, b) => b.score - a.score);
+  }
+
+  async transcribe(ref: string, audio: { bytes: Uint8Array; mime: string; name?: string }, signal?: AbortSignal): Promise<string> {
+    const model = this.find(ref, 'stt');
+    const form = new FormData();
+    form.append('model', this.modelName(model));
+    form.append('file', new Blob([new Uint8Array(audio.bytes)], { type: audio.mime }), audio.name ?? 'audio');
+    const response = await this.post(model, '/audio/transcriptions', form, false, signal);
+    const body = await response.json() as { text?: unknown };
+    if (typeof body.text !== 'string') throw new Error(`${ref} 没有返回转写文本`);
+    return body.text;
+  }
+
+  async speak(ref: string, text: string, options: { voice?: string; signal?: AbortSignal } = {}): Promise<{ bytes: Uint8Array; mime: string }> {
+    const model = this.find(ref, 'tts');
+    const response = await this.post(model, '/audio/speech',
+      JSON.stringify({ model: this.modelName(model), input: text, ...(options.voice ? { voice: options.voice } : {}) }), true, options.signal);
+    return { bytes: new Uint8Array(await response.arrayBuffer()), mime: response.headers.get('content-type')?.split(';')[0] || 'audio/mpeg' };
+  }
+}
+
+/** 非对话模型单次请求的上限;语音合成与长文本嵌入在本机服务上可能要十几秒。 */
+const REQUEST_TIMEOUT_MS = 60_000;
