+/** 目录里的一个模型,含非对话与停用的模型。`entry` 是调用它所需的供应商字段加这个模型的字段。 */
+export interface StoredModel {
+  ref: string;
+  source: string;
+  model: string;
+  type: ModelType;
+  enabled: boolean;
+  entry: LLMProviderEntry;
+}
+
+/** 列出整个目录的模型。旧格式端点算一个对话模型,引用是目录名。 */
+export function readModels(root: string): StoredModel[] {
+  const list: StoredModel[] = [];
+  for (const source of sourceDirs(root)) {
+    const raw = readConfig(root, source);
+    if (!isProviderSource(raw)) {
+      const entry = raw as LLMProviderEntry;
+      list.push({ ref: source, source, model: entry.spec?.model ?? '', type: 'chat', enabled: true, entry });
+      continue;
+    }
+    const { models, ...shared } = raw;
+    for (const [id, model] of Object.entries(models)) {
+      const { type = 'chat', enabled = true, ...fields } = structuredClone(model);
+      if (fields.spec && !fields.spec.model) fields.spec.model = id;
+      list.push({ ref: modelRef(source, id), source, model: id, type, enabled, entry: { ...structuredClone(shared), ...fields } });
+    }
+  }
+  return list;
+}
+
 /** 名字所在的目录:旧格式是端点目录,模型引用是供应商目录。 */
 export function entryDir(root: string, name: string): string {
   return join(root, sourceOf(name));
