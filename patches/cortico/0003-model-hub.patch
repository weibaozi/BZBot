@@ -0,0 +1,149 @@
+/** 模型中心按模型引用调用:对话经 registry,其余类型直连供应商地址,密钥取自供应商目录。 */
+import { afterEach, expect, it } from 'vitest';
+import { createServer, type IncomingMessage } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { makeCfg, makeTmpDir } from '../core/helpers.ts';
+import { nullLogger } from '../../src/core/util.ts';
+import type { Generation, GenerateOptions } from '../../src/core/generation.ts';
+import type { Request } from '../../src/protocol/open-responses/index.ts';
+import { message } from '../../src/protocol/open-responses/context.ts';
+import { BaseProvider, type ProviderModule } from '../../src/providers/base.ts';
+import { ProviderRegistry } from '../../src/providers/registry.ts';
+import { readProviders } from '../../src/providers/store.ts';
+import { ProviderModels } from '../../src/providers/models.ts';
+import { generationUsage, modelOptions, outputText } from '../../src/providers/model-hub.ts';
+import { WorldAssembly, type WorldContext, type WorldDefinition } from '../../src/world.ts';
+import { loadDeployment } from '../../src/deploy.ts';
+
+const cleanups: Array<() => void | Promise<void>> = [];
+afterEach(async () => { for (const fn of cleanups.splice(0)) await fn(); });
+
+/** 脚本化的对话模型:记下请求,回一句固定文本与计量。 */
+const requests: Array<{ request: Request; options?: GenerateOptions }> = [];
+class ScriptedClient extends BaseProvider {
+  async respond(request: Request, options?: GenerateOptions): Promise<Generation> {
+    requests.push({ request, options });
+    return {
+      response: { model: request.model, output: [{ type: 'message', role: 'assistant', content: [{ type: 'output_text', text: 'caption' }] }] },
+      origin: { instance: '', module: 'scripted', model: request.model ?? '' },
+      attempts: [{ meters: { input: 12, output: 3, total: 15, cachedInput: 4, uncachedInput: 8, reasoning: null }, charges: [] }],
+    } as unknown as Generation;
+  }
+}
+const scripted: ProviderModule = {
+  id: 'scripted', title: 'Scripted', reasoningTiers: [], serviceTiers: [], modelTypes: ['chat', 'embedding', 'rerank', 'stt', 'tts'],
+  create: () => ({ client: new ScriptedClient() }),
+};
+const chatOnly: ProviderModule = { ...scripted, id: 'chat-only', modelTypes: undefined };
+
+/** 本机 HTTP 服务:按路径回 OpenAI 兼容的响应,记下收到的头与正文。 */
+async function service() {
+  const seen: Array<{ path: string; headers: IncomingMessage['headers']; body: string }> = [];
+  const server = createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    req.on('data', (c: Buffer) => chunks.push(c));
+    req.on('end', () => {
+      const body = Buffer.concat(chunks).toString('utf8');
+      seen.push({ path: req.url ?? '', headers: req.headers, body });
+      const json = (value: unknown) => { res.setHeader('Content-Type', 'application/json'); res.end(JSON.stringify(value)); };
+      if (req.url === '/v1/embeddings') {
+        const input = (JSON.parse(body) as { input: string[] }).input;
+        return json({ data: input.map((text, index) => ({ index, embedding: [text.length, index] })).reverse() });
+      }
+      if (req.url === '/v1/rerank') return json({ results: [{ index: 0, relevance_score: 0.1 }, { index: 1, relevance_score: 0.9 }] });
+      if (req.url === '/v1/audio/transcriptions') return json({ text: '你好' });
+      if (req.url === '/v1/audio/speech') { res.setHeader('Content-Type', 'audio/wav'); return res.end(Buffer.from('RIFF')); }
+      res.statusCode = 404; res.end();
+    });
+  });
+  await new Promise<void>((done) => server.listen(0, '127.0.0.1', done));
+  cleanups.push(() => new Promise<void>((done) => server.close(() => done())));
+  return { url: `http://127.0.0.1:${(server.address() as AddressInfo).port}/v1`, seen };
+}
+
+async function fixture() {
+  requests.splice(0);
+  const { url, seen } = await service();
+  const temp = makeTmpDir(); cleanups.push(temp.cleanup);
+  const root = join(temp.dir, 'providers');
+  const write = (name: string, config: unknown, env?: string) => {
+    mkdirSync(join(root, name), { recursive: true });
+    writeFileSync(join(root, name, 'config.json'), JSON.stringify(config));
+    if (env) writeFileSync(join(root, name, '.env'), env);
+  };
+  write('local', {
+    kind: 'scripted', baseUrl: url, secret: 'CORTICO_KEY_LOCAL', options: { extraHeaders: { 'X-Gateway': 'g1' } },
+    models: {
+      vision: { type: 'chat', multimodal: true, spec: { model: 'vision', thinking: true, temperature: 0.7, maxTokens: 8192 } },
+      text: { type: 'chat', spec: { model: 'text', thinking: false } },
+      'bge-m3': { type: 'embedding' },
+      old: { type: 'embedding', enabled: false },
+      rank: { type: 'rerank', spec: { model: 'bge-reranker', thinking: false } },
+      whisper: { type: 'stt' },
+      voice: { type: 'tts' },
+    },
+  }, 'CORTICO_KEY_LOCAL=local-key\n');
+  write('limited', { kind: 'chat-only', baseUrl: url, models: { chat: { spec: { model: 'chat', thinking: false } }, vec: { type: 'embedding' } } });
+  const cfg = makeCfg({ providers: readProviders(root), activeProvider: 'local/text' });
+  const registry = new ProviderRegistry(() => cfg.providers, { stateRoot: root, readBlob: () => null, keepThinking: () => true, log: nullLogger() }, [scripted, chatOnly]);
+  return { hub: new ProviderModels(root, () => registry, [scripted, chatOnly]), seen, root, temp };
+}
+
+it('lists enabled models whose type the module supports, filtered by type and image input', async () => {
+  const { hub } = await fixture();
+  expect(hub.list().map(m => m.ref)).toEqual(['limited/chat', 'local/vision', 'local/text', 'local/bge-m3', 'local/rank', 'local/whisper', 'local/voice']);
+  expect(hub.list('embedding').map(m => m.ref)).toEqual(['local/bge-m3']);
+  expect(hub.list('chat', { image: true }).map(m => m.ref)).toEqual(['local/vision']);
+  expect(modelOptions(hub, 'models:chat:image')).toEqual([{ value: 'local/vision', label: 'local/vision' }]);
+  expect(modelOptions(hub, 'models:embedding')).toEqual([{ value: 'local/bge-m3', label: 'local/bge-m3' }]);
+  expect(modelOptions(hub, 'persona-kind')).toBeNull();
+});
+
+it('chats through the registry with one-call overrides and leaves the model configuration alone', async () => {
+  const { hub, root } = await fixture();
+  const generation = await hub.chat('local/vision', [message('user', 'describe')], { overrides: { thinking: false, maxTokens: 1024 }, role: 'memes' });
+  expect(outputText(generation)).toBe('caption');
+  expect(generationUsage(generation)).toEqual({ usage: { promptTokens: 12, completionTokens: 3, cacheHitTokens: 4, cacheMissTokens: 8, reasoningTokens: undefined }, opts: { model: 'vision', charges: [] } });
+  const [{ request, options }] = requests;
+  expect(request).toMatchObject({ model: 'vision', reasoning: { effort: 'none' }, temperature: 0.7, max_output_tokens: 1024 });
+  expect(options).toMatchObject({ role: 'memes', nativeSpec: { model: 'vision', thinking: false, temperature: 0.7, maxTokens: 1024 } });
+  expect(readProviders(root)['local/vision'].spec).toEqual({ model: 'vision', thinking: true, temperature: 0.7, maxTokens: 8192 });
+});
+
+it('calls embedding, rerank, transcription and speech endpoints with the source key and headers', async () => {
+  const { hub, seen } = await fixture();
+  expect(await hub.embed('local/bge-m3', ['a', 'bbb'])).toEqual([[1, 0], [3, 1]]);
+  expect(await hub.rerank('local/rank', 'q', ['x', 'y'])).toEqual([{ index: 1, score: 0.9 }, { index: 0, score: 0.1 }]);
+  expect(await hub.transcribe('local/whisper', { bytes: new Uint8Array([1, 2]), mime: 'audio/wav', name: 'clip.wav' })).toBe('你好');
+  const spoken = await hub.speak('local/voice', '晚安', { voice: 'alloy' });
+  expect([Buffer.from(spoken.bytes).toString(), spoken.mime]).toEqual(['RIFF', 'audio/wav']);
+  expect(seen.map(s => s.path)).toEqual(['/v1/embeddings', '/v1/rerank', '/v1/audio/transcriptions', '/v1/audio/speech']);
+  for (const request of seen) expect([request.headers.authorization, request.headers['x-gateway']]).toEqual(['Bearer local-key', 'g1']);
+  expect(JSON.parse(seen[0].body)).toEqual({ model: 'bge-m3', input: ['a', 'bbb'], encoding_format: 'float' });
+  expect(JSON.parse(seen[1].body).model).toBe('bge-reranker');
+  expect(seen[2].body).toContain('name="model"\r\n\r\nwhisper');
+  expect(JSON.parse(seen[3].body)).toEqual({ model: 'voice', input: '晚安', voice: 'alloy' });
+});
+
+it('refuses missing, disabled, mistyped and unsupported models before any request', async () => {
+  const { hub, seen } = await fixture();
+  await expect(hub.embed('local/absent', ['a'])).rejects.toThrow('没有这个模型');
+  await expect(hub.embed('local/old', ['a'])).rejects.toThrow('已停用');
+  await expect(hub.embed('local/text', ['a'])).rejects.toThrow('类型是 chat');
+  await expect(hub.embed('limited/vec', ['a'])).rejects.toThrow('不支持 embedding');
+  expect(seen).toEqual([]);
+});
+
+it('hands every World the deployment model hub', async () => {
+  const { hub, temp } = await fixture();
+  const seenContexts: WorldContext[] = [];
+  const def: WorldDefinition = {
+    id: 'probe', label: 'Probe', defaults: () => ({ enabled: false }),
+    create: (ctx) => { seenContexts.push(ctx); return { id: 'probe', tools: () => [], envPromptVars: () => null, start: async () => {}, stop: async () => {} }; },
+  };
+  const loaded = loadDeployment({ defaults: () => makeCfg() }, temp.dir, temp.dir);
+  new WorldAssembly(loaded, [def], [], hub);
+  expect(seenContexts[0].models.list('embedding').map(m => m.ref)).toEqual(['local/bge-m3']);
+});
